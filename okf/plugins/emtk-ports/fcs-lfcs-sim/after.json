      "kind": "input_text",
      "label": "tau1_ns",
      "id": "##tau1_ns",
      "tooltip": "Fluorescence lifetime of species 1."
    },
    {
      "kind": "input_text",
      "label": "d1_um2_ms",
      "id": "##d1_um2_ms",
      "tooltip": "Translational diffusion coefficient of species 1. τ_D = w₀²/(4·D)."
    },
    {
      "kind": "input_text",
      "label": "tau2_ns",
      "id": "##tau2_ns",
      "tooltip": "Fluorescence lifetime of species 2."
    },
    {
      "kind": "input_text",
      "label": "d2_um2_ms",
      "id": "##d2_um2_ms",
      "tooltip": "Translational diffusion coefficient of species 2."
    },
    {
      "kind": "input_text",
      "label": "exchange_rate_ms",
      "id": "##exchange_rate_ms",
      "tooltip": "Symmetric species interconversion rate (0 = static species). Set the two diffusion coefficients equal to isolate the exchange in the cross-correlation."
    },
    {
      "kind": "input_text",
      "label": "n_photons",
      "id": "##n_photons",
      "tooltip": "Photon budget. More photons = cleaner filtered correlations (and a slower simulation)."
    },
    {
      "kind": "input_text",
      "label": "seed",
      "id": "##seed",
      "tooltip": "RNG seed (deterministic output)."
    }
