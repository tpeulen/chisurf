    {
     "text": "About ChiSurf",
     "tooltip": "ChiSurf About Plugin\n\nThis plugin provides information about ChiSurf, including version, developer,\nand contact information.\n\nFeatures:\n- Display ChiSurf logo\n- Show version information\n- Display deve"
    },
    {
     "text": "Documentation",
     "tooltip": "Documentation browser and help resource viewer for ChiSurf."
    }
   ]
  },
  "Spectroscopy": {
   "Decay": [
    {
     "text": "Decay Analysis ⚠️",
     "tooltip": "⚠️  Decay Analysis is experimental and not yet validated\nIntegrated fluorescence lifetime analysis tools with IRF estimation, MaxEnt MEM, Lazy Lifetime Analysis, microtime histograms, VV/VH G-factor c"
    }
   ],
   "Correlation": [
    {
     "text": "FCS",
     "tooltip": "Unified **FCS** plugin — a meta tool hosting the FCS workflow behind a rail.\n\nMerges the FCS *Correlator* workflow (detector → files → filter → correlate →\nmerge) with the optional FCS tools (2D-FLCS,"
    },
    {
     "text": "PCH",
     "tooltip": "Photon Counting Histogram (PCH) analysis for single-molecule fluorescence data. Compute PCH histograms from TTTR files and fit multi-species models to extract molecular brightness and occupancy."
    }
   ],
   "Single-Molecule": [
    {
     "text": "ALEX Suite",
     "tooltip": "The classic ALEX-Suite workflow, as a linear ChiSurf pipeline: files, µs-ALEX alternation, burst search, background, accurate FRET, E-S. Plus the titration/stack-plot analysis and the ALEX-Suite CSV e"
    },
    {
     "text": "Burst Analysis",
     "tooltip": "Integrated burst workflow with burst selection, BVA, burst MLE, burst browser, and background estimation."
    },
    {
     "text": "Intensity trace",
     "tooltip": "Intensity Trace Analysis for Single-Molecule Data\n\nThis plugin provides tools for analyzing fluorescence intensity time traces from \nsingle-molecule experiments. It enables researchers to extract dyna"
    },
    {
     "text": "Trace Browser",
     "tooltip": "Browse PTU/TTTR intensity traces from a folder, rate and annotate files, preview traces, and export selected traces."
    },
    {
     "text": "ebFRET ⚠️",
     "tooltip": "⚠️  A plain port of the ebFRET GUI. The VBEM/empirical-Bayes loop is pure NumPy and slower than ebFRET's compiled forward-backward; runs on large datasets take minutes per state count.\nebFRET, ported "
    }
   ],
   "Kinetics": [
    {
     "text": "Hidden Markov model",
     "tooltip": "Gaussian hidden Markov model for binned time traces: fits states and transitions by Baum-Welch, decodes the state path, and reports emissions, dwell times, transition rates and an AIC/BIC state-count "
    }
   ],
   "Imaging": [
    {
     "text": "Image Tools",
     "tooltip": "Unified imaging toolbox: Image Browser, Drift Correction, FRC Resolution, Flow Maps, Particle Tracking, Colocalization, the per-pixel maps, CLSM Draw, Region MLE, PSF Determination, CLSM Generator."
    }
   ]
  },
  "Structure": {
   "Modelling": [
    {
     "text": "ChiMOL",
     "tooltip": "Molecular structure viewer and protein analysis plugin for ChiSurf."
    },
    {
     "text": "Structure Tools",
     "tooltip": "Unified structure toolbox: FPS JSON Editor, FRET Docking  Screening, QuEst, HydroPro and Trajectory Tools."
    }
   ]
  },
  "Tools": {
   "Photon data": [
    {
     "text": "TTTR Tools",
     "tooltip": "Photon-level TTTR toolbox: ALEX Creator, Micro-time Shifter, Photon Table, Count Rate Analysis and Audifier. File-level operations live in File tools."
    }
   ],
   "Calculators": [
    {
     "text": "Calculators",
     "tooltip": "Hub that groups ChiSurf's FRET-line, FRET/homoFRET, FCS and phasor-plot calculators and embeds the selected one in a two-panel view."
    },
    {
     "text": "Light Path Simulator",
     "tooltip": "Optical light path simulator to calculate crosstalk and R0 overlap integrals."
    },
    {
     "text": "Spectra Downloader ⚠️",
     "tooltip": "⚠️  Spectra Downloader is EXPERIMENTAL and UNTESTED — results are not validated\nDownload, browse and push optical-component spectra (fluorophores, filters, dichroics, detectors, light sources)"
    },
    {
     "text": "Wizards",
     "tooltip": "Hub that lists ChiSurf's guided wizards and embeds the selected one in a two-panel view."
    }
   ],
   "Views": [
    {
     "text": "Acquisition",
     "tooltip": "Single-molecule fluorescence acquisition: stream photons from real TCSPC hardware or the built-in tttrlib Sim* photon simulator (confocal diffusion with FRET, anisotropy and photophysics)."
    },
    {
     "text": "Global View",
     "tooltip": "Interactive network graph for visualizing and managing parameter relationships across fits in global analysis."
    },
    {
     "text": "ndX",
     "tooltip": "Multidimensional fluorescence data analysis and visualization tool. Supports burst analysis, multiparameter fluorescence detection (MFD), FRET calculations, and interactive selection/filtering of burs"
    }
   ],
   "System": [
    {
     "text": "Code Editor",
     "tooltip": "Shared multi-document code/text editor with project navigation, symbols, diagnostics, and optional Python LSP integration."
    },
    {
     "text": "Games",
     "tooltip": "A collection of built-in games: Number Quest, Minesweeper, Tetris, Pong, and Breakout."
    },
    {
     "text": "MMFDB Admin",
     "tooltip": "Manage the Multiparametric Fluorescence Database (MMFDB): samples, experiments, setups, raw/processed data, provenance, and project archives."
    }
   ]
  }
