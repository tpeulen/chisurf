    {
     "text": "Trace Browser",
     "tooltip": "Browse PTU/TTTR intensity traces from a folder, rate and annotate files, preview traces, and export selected traces."
    },
    {
     "text": "ebFRET ⚠️",
     "tooltip": "⚠️  A plain port of the ebFRET GUI. The VBEM/empirical-Bayes loop is pure NumPy and slower than ebFRET's compiled forward-backward; runs on large datasets take minutes per state count.\nebFRET, ported "
    }
   ],
   "Kinetics": [
