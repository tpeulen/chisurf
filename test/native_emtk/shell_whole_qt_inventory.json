   "Data": [
    {
     "text": "BID→Analysis",
     "tooltip": "BID → Analysis Converter\n\nThis plugin reads burst ID (BID) files containing start/stop photon indices\nand generates a burstwise analysis folder next to the corresponding TTTR data.\n\nWorkflow per BID f"
    },
    {
     "text": "MFD Prepare",
     "tooltip": "Prepare a burst folder for multiparameter-fluorescence (MFD) analysis: resolve photon sources, verify channel counts, compute mean micro times, and inspect the preparation report."
    },
    {
     "text": "PTO Inspector",
     "tooltip": "Inspect a .pto photon container: every object in it, the provenance graph that says how each came to be, the payload as a table or a curve, and the settings that are the recipe. Double-click a step to"
    },
    {
     "text": "Split/Convert",
     "tooltip": "TTTR Split / Convert plugin.\n\nThis plugin provides functionality for splitting large TTTR (Time-Tagged Time-Resolved)\nfiles, particularly those in the PicoQuant PTU format, into smaller segments. This"
    },
    {
     "text": "TTTR Header editor",
     "tooltip": "TTTR Header Editor plugin.\n\nThis plugin provides a tool for viewing and editing header tags of any\ntime-tagged time-resolved (TTTR) file that :mod:`tttrlib` can read — PicoQuant\nPTU and HT3, BeckerHic"
    },
    {
     "text": "TTTR→Time-Window BIDs",
     "tooltip": "Split TTTR files into fixed-duration time-window BID (.bst) files."
    },
    {
     "text": "⇄ .pto",
     "tooltip": "Convert between a vendor photon file (.ptu, .spc, .ht3, ...) and ChiSurf's own .pto container, in either direction. Drop a vendor file to pack it into a .pto beside it; drop a .pto to unpack the vendo"
    }
   ]
