{
  "title": "Distance Network settings",
  "sections": [
    {
      "type": "panel",
      "title": "Distance network",
      "sections": [
        {"type": "button_row", "buttons": [
          {"action": "goto_first", "label": "|<", "description": "Stop playback and go to the first frame."},
          {"action": "goto_prev", "label": "<", "description": "Back by the step size."},
          {"action": "play", "label": "▶", "description": "Play through the frames until stopped."},
          {"action": "stop", "label": "■", "description": "Stop playback and return to the first frame."},
          {"action": "goto_next", "label": ">", "description": "Forward by the step size; wraps to the first frame."},
          {"action": "goto_last", "label": ">|", "description": "Last frame."}
        ]},
        {
          "type": "panel",
          "n_col": 2,
          "sections": [
            {"type": "value", "attr": "frame", "kind": "int", "style": "spin", "label": "Frame",
             "minimum": 0, "description": "The frame whose distances the network compares against the restraints."},
            {"type": "info", "source": "frame_total_text", "width": 70}
          ]
        },
        {"type": "value", "attr": "step", "kind": "int", "style": "spin", "label": "Step size",
         "minimum": 1, "maximum": 1000000, "description": "Number of frames to jump per Play/Next step."}
      ]
    }
  ]
}
