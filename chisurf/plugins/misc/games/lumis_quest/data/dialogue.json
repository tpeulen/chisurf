{
  "_comment": "Every scene in the game. A scene is a list of steps: say, say_from (plays the lines the host handed in, e.g. a Warden's own three screens), choice, when, do, goto. '$subject' resolves to whatever is being spoken to -- a warden key, an order key. Nothing here is known to the renderer: an NPC carries a scene id and the engine does the rest. Keep every 'say' under ~180 characters and write -- rather than an em dash.",

  "scenes": {
    "talk": [
      {"say_from": "lines"}
    ],

    "elder": [
      {"say_from": "lines"},
      {"do": "flag", "args": {"name": "wake"}}
    ],

    "lumi": [
      {"say_from": "lines"},
      {"do": "companion"}
    ],

    "healer": [
      {"say_from": "lines"},
      {"choice": [
        {"text": "Rest here.", "then": [
          {"do": "restore", "args": {"fraction": 1.0,
           "text": "The pad warms. Everything you carry comes back up to full."}}
        ]},
        {"text": "Later."}
      ]}
    ],

    "tavern": [
      {"say_from": "lines"},
      {"goto": "tavern_menu"}
    ],

    "tavern_menu": [
      {"say": "What will it be?", "choice": [
        {"text": "What have you heard?", "then": [
          {"do": "rumour"},
          {"goto": "tavern_menu"}
        ]},
        {"text": "A meal and an hour by the fire.", "then": [
          {"do": "restore", "args": {"fraction": 0.5,
           "text": "Bread, and somewhere warm. Your team comes back halfway."}}
        ]},
        {"text": "Nothing today."}
      ]}
    ],

    "shop": [
      {"say_from": "lines"},
      {"say": "Glass, then?", "choice": [
        {"text": "Show me something that suits my team.", "then": [
          {"do": "supply", "args": {"kind": "match"}}
        ]},
        {"text": "Something forgiving, for a beginner.", "then": [
          {"do": "supply", "args": {"kind": "wide"}}
        ]},
        {"text": "Something selective.", "when": {"seals": 2}, "then": [
          {"do": "supply", "args": {"kind": "narrow"}}
        ]},
        {"text": "Only looking."}
      ]}
    ],

    "smithy": [
      {"say_from": "lines"},
      {"choice": [
        {"text": "Grind what I am wearing narrower.", "then": [
          {"do": "grind"}
        ]},
        {"text": "Not today."}
      ]}
    ],

    "shrine": [
      {"say_from": "lines"},
      {"choice": [
        {"text": "Rest, and write the day down.", "then": [
          {"do": "restore", "args": {"fraction": 1.0,
           "text": "Everything you carry comes back up to full."}},
          {"do": "save", "args": {"text": "The day is written down."}}
        ]},
        {"text": "Walk on."}
      ]}
    ],

    "warden": [
      {"when": {"seal": "$subject"},
       "then": [
         {"say_from": "after"},
         {"say": "Go on. There are four others and they are all harder than me."}
       ],
       "else": [{"goto": "warden_challenge"}]}
    ],

    "warden_challenge": [
      {"say_from": "lines"},
      {"choice": [
        {"text": "Face them.", "then": [
          {"do": "battle", "args": {"warden": "$subject"}}
        ]},
        {"text": "Not yet.", "then": [
          {"say": "Sensible. Come back when you have something worth fielding."}
        ]}
      ]}
    ],

    "emissary": [
      {"say_from": "lines"},
      {"when": {"pledged": true},
       "then": [{"say": "You have already given your word elsewhere. Keep it."}],
       "else": [{"goto": "emissary_pledge"}]}
    ],

    "emissary_pledge": [
      {"choice": [
        {"text": "I will serve.", "when": {"seals": 3}, "then": [
          {"do": "pledge", "args": {"order": "$subject"}},
          {"say": "Then it is said, and saying it was the easy half."}
        ]},
        {"text": "I will serve.", "when": {"not": {"seals": 3}}, "then": [
          {"say": "Not yet. Carry three Warden seals and I will believe you have an opinion rather than a mood."}
        ]},
        {"text": "I will think about it."}
      ]}
    ],

    "cave": [
      {"say": "A cave mouth, and cold air coming out of it that smells of nothing at all."},
      {"choice": [
        {"text": "Go down.", "then": [
          {"do": "flag", "args": {"name": "the-crossing"}},
          {"do": "cross", "args": {"to": "dark"}}
        ]},
        {"text": "Stay in the light."}
      ]}
    ],

    "rift": [
      {"say": "A seam of ordinary daylight, the wrong way up."},
      {"choice": [
        {"text": "Climb back into the light.", "then": [
          {"do": "cross", "args": {"to": "light"}}
        ]},
        {"text": "Not yet."}
      ]}
    ],

    "lanternwright": [
      {"do": "flag", "args": {"name": "the-lanternwright"}},
      {"say_from": "lines"},
      {"choice": [
        {"text": "Answer her.", "then": [
          {"say_from": "reply"},
          {"say": "She looks at you for a while. Then she puts the ledger down, which she has not done in forty years."},
          {"do": "flag", "args": {"name": "dawn"}}
        ]},
        {"text": "Say nothing.", "then": [
          {"say": "She waits. You have nothing, and she can tell. Come back when you have served somebody."}
        ]}
      ]}
    ],

    "wraith": [
      {"say_from": "lines"},
      {"do": "flag", "args": {"name": "the-shelved"}},
      {"when": {"labels": 1},
       "then": [
         {"say": "It is waiting to see whether you brought any light with you.",
          "choice": [
            {"text": "Give it one of your labels.", "then": [
              {"do": "rekindle", "args": {"species": "$subject"}}
            ]},
            {"text": "You have not come here to do that."}
          ]}
       ],
       "else": [
         {"say": "You have nothing on you it could use. It goes back to waiting."}
       ]}
    ],

    "beast": [
      {"say": "It is burning, and it cannot stop."}
    ],

    "overheard": [
      {"say_from": "lines"},
      {"say": "They stop, and look at you.", "choice": [
        {"text": "Ask them what they meant.", "then": [
          {"do": "join"},
          {"say": "They tell it again, slower, and with less of it left out."}
        ]},
        {"text": "Leave them to it."}
      ]}
    ]
  }
}
