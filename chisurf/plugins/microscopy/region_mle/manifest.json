{
  "id": "region_mle",
  "version": "2.1.0",
  "display_name": "Imaging:Lifetime:Region MLE",
  "description": "Region MLE lifetime analysis from TTTR imaging data (PTU).",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Imaging",
    "Lifetime"
  ],
  "icon": "🔬",
  "state_namespace": "region_mle",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "gui": "chisurf.plugins.microscopy.region_mle.gui.tool:RegionMleTool",
    "cli": "region-mle=chisurf.plugins.microscopy.region_mle.cli:cli",
    "services": "chisurf.plugins.microscopy.region_mle.backend.services:register_services"
  },
  "rpc_methods": [
    {
      "name": "region_mle.analyze.run",
      "summary": "Run molecule-wise MLE on PTU files.",
      "params_schema": {
        "type": "object",
        "required": [
          "files",
          "irf_file"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "irf_file": {
            "type": "string"
          },
          "output_dir": {
            "type": "string"
          },
          "settings": {
            "type": "object"
          }
        }
      },
      "result_schema": {
        "type": "object"
      },
      "long_running": true,
      "cancelable": false
    },
    {
      "name": "region_mle.contract.describe",
      "summary": "Return the RPC contract.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    }
  ],
  "events": [
    {
      "topic": "region_mle.state.*",
      "description": "State patch events"
    }
  ],
  "operation_types": [
    "molecule_localization"
  ],
  "requires": {
    "mle_common": "*"
  },
  "optional_requires": {
    "spot_finder": "*"
  },
  "menu_hidden": true
}
