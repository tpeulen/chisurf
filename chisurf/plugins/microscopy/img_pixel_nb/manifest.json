{
  "id": "img_pixel_nb",
  "version": "1.0.0",
  "display_name": "Spectroscopy:Imaging:Number & Brightness",
  "description": "Per-pixel Number & Brightness from TTTR imaging stacks: apparent B and N, molecular brightness and number, cross N&B, analog-detector calibration, bleaching detrending, and gating a brightness population back onto the image.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Spectroscopy",
    "Imaging"
  ],
  "icon": "✨",
  "state_namespace": "img_pixel_nb",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.microscopy.img_pixel_nb.gui.app:make_app",
    "cli": "img-pixel-nb=chisurf.plugins.microscopy.img_pixel_nb.cli:cli"
  },
  "operation_types": [
    "number_and_brightness"
  ],
  "requires": {
    "imaging_common": "*"
  },
  "menu_hidden": true,
  "accepts": [
    {
      "name": "image",
      "summary": "The photon image whose number and brightness are mapped.",
      "receive": "chisurf.plugins.microscopy.imaging_emtk.app_base:receive_input",
      "required": [
        "file"
      ],
      "from_workspace": {
        "kinds": [
          "image",
          "photons"
        ],
        "many": false,
        "key": "file",
        "representations": [
          "photons"
        ]
      }
    }
  ]
}
