{
  "id": "img_pixel_mle",
  "version": "2.0.0",
  "display_name": "Spectroscopy:Imaging:Lifetime:Pixel-wise MLE",
  "description": "Pixel-wise MLE lifetime analysis for TTTR imaging data.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Spectroscopy",
    "Imaging",
    "Lifetime"
  ],
  "icon": "🔬",
  "state_namespace": "img_pixel_mle",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "cli": "img-pixel-mle=chisurf.plugins.microscopy.img_pixel_mle.cli:cli",
    "services": "chisurf.plugins.microscopy.img_pixel_mle.backend.services:register_services",
    "emtk": "chisurf.plugins.microscopy.img_pixel_mle.gui.app:make_app"
  },
  "rpc_methods": [
    {
      "name": "img_pixel_mle.analyze.run",
      "summary": "Run pixel-wise MLE on TTTR imaging data.",
      "params_schema": {
        "type": "object",
        "required": [
          "files",
          "irf_file"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "irf_file": {
            "type": "string"
          },
          "settings": {
            "type": "object"
          }
        }
      },
      "result_schema": {
        "type": "object"
      },
      "long_running": true,
      "cancelable": false
    },
    {
      "name": "img_pixel_mle.contract.describe",
      "summary": "Return the RPC contract.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    }
  ],
  "events": [
    {
      "topic": "img_pixel_mle.state.*",
      "description": "State patch events"
    }
  ],
  "requires": {
    "mle_common": "*"
  },
  "menu_hidden": true,
  "optional_requires": {
    "img_pixel_nb": "*"
  },
  "accepts": [
    {
      "name": "files",
      "summary": "The CLSM photon images fitted pixel by pixel.",
      "receive": "chisurf.plugins.microscopy.imaging_emtk.app_base:receive_input",
      "required": [
        "files"
      ],
      "from_workspace": {
        "kinds": [
          "image",
          "photons"
        ],
        "many": true,
        "key": "files",
        "representations": [
          "photons"
        ]
      }
    },
    {
      "name": "irf_files",
      "summary": "The IRF photon streams of the fit.",
      "receive": "chisurf.plugins.microscopy.imaging_emtk.app_base:receive_input",
      "required": [
        "irf_files"
      ],
      "from_workspace": {
        "kinds": [
          "image",
          "photons"
        ],
        "many": true,
        "key": "irf_files",
        "representations": [
          "photons"
        ]
      }
    }
  ]
}
