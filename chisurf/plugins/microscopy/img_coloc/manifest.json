{
  "id": "img_coloc",
  "version": "1.0.0",
  "display_name": "Spectroscopy:Imaging:Colocalization",
  "description": "Two-channel colocalization (Pearson, Manders, Costes, Li ICQ) on TIFF stacks and photon-stream images, with an interactive intensity scatter gate.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Spectroscopy",
    "Imaging"
  ],
  "icon": "🔗",
  "state_namespace": "img_coloc",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "cli": "img-coloc=chisurf.plugins.microscopy.img_coloc.cli:cli",
    "emtk": "chisurf.plugins.microscopy.img_coloc.gui.app:make_app"
  },
  "menu_hidden": true,
  "accepts": [
    {
      "name": "image",
      "summary": "The two-channel image whose colocalization is measured.",
      "receive": "chisurf.plugins.microscopy.imaging_emtk.app_base:receive_input",
      "required": [
        "file"
      ],
      "from_workspace": {
        "kinds": [
          "image",
          "photons"
        ],
        "many": false,
        "key": "file",
        "representations": [
          "photons",
          "intensity"
        ]
      }
    }
  ]
}
