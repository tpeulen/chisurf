{
  "id": "img_calibration",
  "version": "1.0.0",
  "display_name": "Spectroscopy:Imaging:IRF & BG",
  "description": "Per-detector IRF file and background (kHz) calibration; transferred to phasor and pixel-wise MLE. Optional (skippable) pipeline step.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Spectroscopy",
    "Imaging"
  ],
  "icon": "🎛️",
  "state_namespace": "img_calibration",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.microscopy.img_calibration.gui.app:make_app"
  },
  "menu_hidden": true,
  "accepts": [
    {
      "name": "source",
      "summary": "The source photon data whose decay is calibrated (a photon stream or a photon image).",
      "receive": "chisurf.plugins.microscopy.img_calibration.gui.app:receive_source",
      "required": [
        "source"
      ],
      "from_workspace": {
        "kinds": [
          "photons",
          "image"
        ],
        "representations": [
          "photons"
        ],
        "many": false,
        "key": "source"
      }
    },
    {
      "name": "irf",
      "summary": "IRF photon files for the selected detector; they are summed into its IRF.",
      "receive": "chisurf.plugins.microscopy.img_calibration.gui.app:receive_irf",
      "required": [
        "irf"
      ],
      "from_workspace": {
        "kinds": [
          "photons"
        ],
        "many": true,
        "key": "irf"
      }
    }
  ]
}
