{
  "id": "setup",
  "version": "1.0.0",
  "display_name": "Setup:Settings",
  "single_instance": true,
  "description": "The Settings window: one searchable list of every settings panel (ChiSurf settings, acquisition, styles, plots, models, users, plugins, updates, detector setup, ...).",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Setup"
  ],
  "icon": "\u2699\ufe0f",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": "settings_window"
    }
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.core.setup.gui.app:make_app"
  },
  "optional_requires": {
    "boarding": "*",
    "fcs_channel_preset": "*",
    "model_manager": "*",
    "plot_settings": "*",
    "plugin_check": "*",
    "plugin_manager": "*",
    "setup_channel_definition": "*",
    "style_manager": "*",
    "tttr_lut_tools": "*",
    "updater": "*",
    "user_editor": "*",
    "zenodo_deposit": "*"
  }
}
