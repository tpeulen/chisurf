{
  "id": "code_editor",
  "version": "2.1.0",
  "display_name": "Tools:System:Code Editor",
  "description": "Shared multi-document code/text editor with project navigation, symbols, diagnostics, and optional Python LSP integration.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Tools",
    "System"
  ],
  "icon": "📝",
  "state_namespace": "code_editor",
  "state_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "recent_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "project_root": {
        "type": [
          "string",
          "null"
        ]
      },
      "settings": {
        "type": "object"
      }
    }
  },
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": "code_editor_window"
    }
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.core.code_editor.gui.editor_app:make_editor_app"
  },
  "accepts": [
    {
      "name": "open_file",
      "summary": "Open a source file in the code editor, optionally at a line, as a source link does.",
      "receive": "chisurf.plugins.core.code_editor.gui.editor_app:receive_open_file",
      "required": [
        "path"
      ]
    }
  ],
  "rpc_methods": [
    {
      "name": "editor.document.list",
      "summary": "List open editor documents."
    },
    {
      "name": "editor.document.get",
      "summary": "Get an open editor document."
    },
    {
      "name": "editor.document.set",
      "summary": "Replace an open editor document."
    },
    {
      "name": "editor.document.apply_edits",
      "summary": "Apply text edits to an open editor document."
    },
    {
      "name": "editor.document.ruff_check",
      "summary": "Run Ruff on an open editor document."
    },
    {
      "name": "editor.document.ruff_fix",
      "summary": "Run Ruff fixes on an open editor document."
    }
  ],
  "dependencies": {
    "python-lsp-server": ">=1.14",
    "ruff": ">=0.4"
  },
  "optional_requires": {
    "ai_settings": "*"
  }
}
