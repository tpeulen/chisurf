{
  "id": "setup_channel_definition",
  "version": "1.0.0",
  "display_name": "Setup:Channel Definition",
  "description": "Detector Channel and PIE-window definition wizard",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Setup"
  ],
  "icon": "🔢",
  "menu_hidden": true,
  "statefulness": {
    "enabled": false,
    "window": {
      "enabled": false
    }
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.core.setup_channel_definition.gui.app:make_app"
  },
  "accepts": [
    {
      "name": "measurement",
      "summary": "A photon stream whose routing channels and micro times the definition reads.",
      "receive": "chisurf.plugins.core.setup_channel_definition.gui.app:receive_measurement",
      "required": [
        "measurement"
      ],
      "from_workspace": {
        "kinds": [
          "photons"
        ],
        "many": false,
        "key": "measurement"
      }
    },
    {
      "name": "setup",
      "summary": "A setups library (becomes the library) or a LUT table (for the selected channel row).",
      "receive": "chisurf.plugins.core.setup_channel_definition.gui.app:receive_setup",
      "required": [
        "setup"
      ],
      "from_workspace": {
        "kinds": [
          "setup"
        ],
        "many": false,
        "key": "setup"
      }
    }
  ]
}
