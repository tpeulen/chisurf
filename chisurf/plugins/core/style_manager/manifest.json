{
  "id": "style_manager",
  "version": "1.0.0",
  "display_name": "Setup:Styles",
  "description": "Edit ChiSurf's emtk style sheets (.css files in the settings directory) and apply one to the running window.",
  "authors": ["Thomas-Otavio Peulen"],
  "categories": ["Setup"],
  "icon": "🎨",
  "menu_hidden": true,
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": "style_manager_window"
    }
  },
  "optional_requires": {
    "code_editor": "*"
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.core.style_manager.gui.app:make_style_manager_app"
  }
}
