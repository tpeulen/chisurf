{
  "id": "mmfdb_admin",
  "version": "1.1.0",
  "display_name": "Tools:MMFDB Admin",
  "description": "Manage the Multiparametric Fluorescence Database (MMFDB): samples, experiments, setups, raw/processed data, provenance, and project archives.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Tools",
    "Fluorescence",
    "Database"
  ],
  "icon": "🗃️",
  "state_namespace": "mmfdb_admin",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "gui": "chisurf.plugins.core.mmfdb_admin.gui.tool:MMFDBWidget",
    "services": "chisurf.core.mmfdb_services:register_services"
  },
  "rpc_methods": [
    {
      "name": "fluorophores.diffusion_reference",
      "summary": "List every probe carrying a diffusion coefficient D(25 °C, water).",
      "params_schema": {
        "type": "object",
        "properties": {
          "seed_if_empty": {
            "type": "boolean",
            "description": "Seed the literature reference values when the table is empty."
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "species": {
            "type": "array"
          }
        }
      }
    },
    {
      "name": "fluorophores.import_diffusion_reference",
      "summary": "Seed literature diffusion coefficients as probe properties.",
      "params_schema": {
        "type": "object",
        "properties": {
          "mark_verified": {
            "type": "boolean",
            "description": "Mark the imported values as verified."
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
