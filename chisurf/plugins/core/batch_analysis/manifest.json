{
  "id": "batch_analysis",
  "version": "1.0.0",
  "display_name": "Tools:Wizards:Batch Analysis",
  "description": "Apply one pre-optimised template fit to many datasets or files in one pass and export the consolidated results (CSV, DOCX report, per-run ZIP).",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Tools",
    "Wizards",
    "Analysis"
  ],
  "icon": "📚",
  "state_namespace": "batch_analysis",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.core.batch_analysis.gui.app:make_app",
    "cli": "batch-analysis=chisurf.plugins.core.batch_analysis.cli:cli"
  },
  "rpc_methods": [],
  "dependencies": {},
  "accepts": [
    {
      "name": "files",
      "summary": "Measurements of the Datasets workspace loaded one by one and fitted with the template.",
      "receive": "chisurf.plugins.core.batch_analysis.gui.app:receive_files",
      "required": [
        "files"
      ],
      "from_workspace": {
        "kinds": [
          "decay",
          "correlation",
          "histogram",
          "trace",
          "photons"
        ],
        "many": true,
        "key": "files"
      }
    }
  ]
}
