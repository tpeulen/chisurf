{
  "id": "fcs_filter_calculator",
  "version": "1.0.0",
  "display_name": "Spectroscopy:Correlation:FCS Filter Calculator",
  "description": "Compute filtered-FCS (fFCS) lifetime filters from microtime decay patterns.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Spectroscopy",
    "Fluorescence Correlation Spectroscopy",
    "Correlation"
  ],
  "icon": "🎚️",
  "state_namespace": "fcs_filter_calculator",
  "state_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "total_path": {
        "type": "string"
      },
      "species_paths": {
        "type": "array"
      }
    }
  },
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "accepts": [
    {
      "name": "fcs_correlator_files",
      "summary": "Read the FCS correlator's checked files as the mixed decay, on its micro-time binning.",
      "receive": "chisurf.plugins.fcs.fcs_filter_calculator.gui.app:receive_correlator_files",
      "required": [
        "files"
      ]
    },
    {
      "name": "mixed",
      "summary": "The measured mixed decay: photon streams or decay curves of the workspace.",
      "receive": "chisurf.plugins.fcs.fcs_filter_calculator.gui.app:receive_mixed",
      "required": [
        "mixed"
      ],
      "from_workspace": {
        "kinds": [
          "photons",
          "decay"
        ],
        "many": true,
        "key": "mixed"
      }
    },
    {
      "name": "reference",
      "summary": "Measured reference decays of one species, added as a component.",
      "receive": "chisurf.plugins.fcs.fcs_filter_calculator.gui.app:receive_reference",
      "required": [
        "reference"
      ],
      "from_workspace": {
        "kinds": [
          "photons",
          "decay"
        ],
        "many": true,
        "key": "reference"
      }
    },
    {
      "name": "irf",
      "summary": "A measured IRF (photon stream or decay curve) for the selected detector row.",
      "receive": "chisurf.plugins.fcs.fcs_filter_calculator.gui.app:receive_irf",
      "required": [
        "irf"
      ],
      "from_workspace": {
        "kinds": [
          "photons",
          "decay"
        ],
        "many": false,
        "key": "irf"
      }
    },
    {
      "name": "project",
      "summary": "A saved filter-calculator project (a setup row of the workspace).",
      "receive": "chisurf.plugins.fcs.fcs_filter_calculator.gui.app:receive_project",
      "required": [
        "project"
      ],
      "from_workspace": {
        "kinds": [
          "setup"
        ],
        "many": false,
        "key": "project"
      }
    }
  ],
  "entrypoints": {
    "cli": "chisurf.plugins.fcs.fcs_filter_calculator.cli.main:main",
    "services": "chisurf.plugins.fcs.fcs_filter_calculator.backend.services:register_services",
    "emtk": "chisurf.plugins.fcs.fcs_filter_calculator.gui.app:create_app"
  },
  "rpc_methods": [
    {
      "name": "fcs_filter.compute",
      "summary": "Compute fFCS filters from arrays.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "fcs_filter.compute_from_files",
      "summary": "Compute fFCS filters from histogram files.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "fcs_filter.compute_mfd",
      "summary": "Compute MFD fFCS filters from arrays.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "fcs_filter.compute_mfd_from_files",
      "summary": "Compute MFD fFCS filters from files.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    }
  ],
  "events": [],
  "dependencies": {},
  "experimental": true,
  "experimental_message": "FCS Filter Calculator is experimental and not yet validated",
  "deprecated": false,
  "requires": {
    "tttr_splitter": "*"
  }
}
