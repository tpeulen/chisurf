{
  "id": "fret_line",
  "version": "1.0.0",
  "display_name": "Tools:Calculators:FRET Line Generator",
  "description": "Compute static, dynamic, WLC, and mixture FRET lines for parameter ranges. Results are suitable for overlaying on smFRET 2D histograms in ndX.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Tools",
    "Calculators",
    "FRET",
    "Analysis"
  ],
  "icon": "🧵",
  "state_namespace": "fret_line",
  "state_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "last_settings": {
        "type": "object"
      }
    }
  },
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.fret_line.gui.app:make_app",
    "cli": "chisurf.plugins.fret_line.__main__:main",
    "services": "chisurf.plugins.fret_line.backend.services:register_services"
  },
  "rpc_methods": [],
  "events": [],
  "dependencies": {},
  "deprecated": false,
  "optional_requires": {
    "ndxplorer": "*"
  }
}
