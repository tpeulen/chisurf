{
  "id": "tttr_audifier",
  "version": "2.0.0",
  "display_name": "Tools:Photon data:Audifier",
  "description": "Convert TTTR photon streams to audio, with a live micro-time / lifetime waterfall preview.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": ["Tools", "Photon data", "TTTR", "Analysis"],
  "icon": "🎵",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "accepts": [
    {"name": "photons", "summary": "Load a photon stream (a TTTR file or a container stream) and, chosen with it, a detector setup row.", "receive": "chisurf.plugins.tttr.audifier.gui.app:receive_photons", "required": ["file"], "from_workspace": {"kinds": ["photons"], "key": "file", "with_setup": true}}
  ],
  "entrypoints": {
    "emtk": "chisurf.plugins.tttr.audifier.gui.app:create_app"
  },
  "requires": {
    "tttr_splitter": "*"
  }
}
