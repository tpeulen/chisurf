{
  "id": "microtime_shifter",
  "version": "2.0.0",
  "display_name": "Tools:Photon data:Microtime Shifter",
  "description": "Apply global and per-channel micro-time shifts to TTTR files.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": ["Tools", "Photon data", "TTTR", "Editor"],
  "icon": "\u2194\ufe0f",
  "state_namespace": "microtime_shifter",
  "state_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "last_file": {
        "type": [
          "string",
          "null"
        ]
      },
      "global_shift": {
        "type": "integer"
      },
      "channel_shifts": {
        "type": "object"
      }
    }
  },
  "statefulness": {
    "enabled": false
  },
  "accepts": [
    {"name": "photons", "summary": "Queue TTTR files to shift their micro-times (a container stream is unpacked first with TTTR ⇄ .pto).", "receive": "chisurf.plugins.tttr.tttr_microtime_shifter.gui.app:receive_photons", "required": ["files"], "from_workspace": {"kinds": ["photons"], "many": true, "key": "files"}}
  ],
  "entrypoints": {
    "cli": "microtime-shift=chisurf.plugins.tttr.tttr_microtime_shifter.cli.main:cli",
    "services": "chisurf.plugins.tttr.tttr_microtime_shifter.backend.services:register_services",
    "emtk": "chisurf.plugins.tttr.tttr_microtime_shifter.gui.app:create_app"
  },
  "operation_types": [
    "microtime_shift"
  ],
  "rpc_methods": [
    {
      "name": "microtime_shift.apply",
      "summary": "Apply micro-time shifts to TTTR files.",
      "params_schema": "api.contract#/inputs/Apply",
      "result_schema": "api.contract#/outputs/ServiceResult",
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "microtime_shift.load_metadata",
      "summary": "Return routing channels and n_mt for a file.",
      "params_schema": "api.contract#/inputs/LoadMetadata",
      "result_schema": "api.contract#/outputs/ServiceResult",
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "microtime_shift.identify",
      "summary": "Look up a file in the MMFDB object store.",
      "params_schema": "api.contract#/inputs/Identify",
      "result_schema": "api.contract#/outputs/ServiceResult",
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "microtime_shift.contract.describe",
      "summary": "Return the Micro-time Shifter workflow contract.",
      "params_schema": {},
      "result_schema": "api.contract",
      "long_running": false,
      "cancelable": false
    }
  ],
  "requires": {
    "tttr_splitter": "*"
  }
}
