    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": "lifetime_analysis_window"
    }
  },
  "entrypoints": {
    "gui": "chisurf.plugins.fluorescence_decay.lifetime_analysis.gui.tool:LifetimeAnalysisTool"
  },
  "optional_requires": {
    "irf_estimator": "*",
    "lltf": "*",
    "maxent_decay": "*",
    "microtime_histogram": "*",
    "vv_vh_g_factor": "*"
  },
  "experimental": true,
  "experimental_message": "Decay Analysis is experimental and not yet validated",
  "menu_hidden": false
