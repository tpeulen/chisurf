{
  "id": "lltf",
  "version": "1.0.0",
  "display_name": "Spectroscopy:Decay:Lazy Lifetime Analysis",
  "icon": "⏳",
  "description": "Lazy Lifetime Analysis for TCSPC fluorescence decay data.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Spectroscopy",
    "Fluorescence decay",
    "Decay"
  ],
  "state_namespace": "lltf",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "accepts": [
    {
      "name": "decays",
      "summary": "Fit a decay with its instrument response: the picked curve named IRF (or the second) is the IRF, one named VH the VH channel of a VV/VH fit.",
      "receive": "chisurf.plugins.fluorescence_decay.lltf.gui.app:receive_decays",
      "required": ["decays"],
      "from_workspace": {"kinds": ["decay"], "many": true, "key": "decays"}
    }
  ],
  "entrypoints": {
    "cli": "lltf=chisurf.plugins.fluorescence_decay.lltf.core.cli:cli",
    "emtk": "chisurf.plugins.fluorescence_decay.lltf.gui.app:make_app"
  },
  "experimental": true,
  "experimental_message": "Lazy Lifetime Analysis is experimental and not yet validated"
}
