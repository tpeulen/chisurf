{
  "id": "ndxplorer",
  "version": "1.0.0",
  "display_name": "Main:Tools:ndX",
  "description": "Multidimensional fluorescence data analysis and visualization tool. Supports burst analysis, multiparameter fluorescence detection (MFD), FRET calculations, and interactive selection/filtering of burst events for both single-molecule and image spectroscopy data.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Main",
    "Tools"
  ],
  "icon": "🔭",
  "state_namespace": "ndxplorer",
  "entrypoints": {
    "gui": "chisurf.plugins.ndxplorer.rpc_bridge:make_ndxplorer",
    "cli": "ndxplorer=chisurf.plugins.ndxplorer.cli:cli"
  },
  "operation_types": [
    "burst_filtering",
    "filtering",
    "ndxplorer_selection",
    "ndxplorer_clustering",
    "population_selection"
  ],
  "optional_requires": {
    "burst_fcs_correlator": "*",
    "burst_mle_analysis": "*",
    "fret_line": "*",
    "img_pixel_phasor": "*",
    "mmfdb_admin": "*"
  }
}
