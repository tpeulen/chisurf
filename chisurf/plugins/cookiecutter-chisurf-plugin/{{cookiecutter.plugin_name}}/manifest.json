{
  "id": "{{ cookiecutter.plugin_name }}",
  "version": "1.1.0",
  "display_name": "{{ cookiecutter.plugin_category }}:{{ cookiecutter.plugin_display_name }}",
  "description": "{{ cookiecutter.plugin_description }}",
  "authors": ["{{ cookiecutter.author_name }} <{{ cookiecutter.author_email }}>"],
  "categories": ["{{ cookiecutter.plugin_category }}"],
  "icon": "icon.png",
  "state_namespace": "{{ cookiecutter.plugin_name }}",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "state_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {}
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.{{ cookiecutter.plugin_name }}.gui.app:make_app",
    "cli": "{{ cookiecutter.plugin_name }}=chisurf.plugins.{{ cookiecutter.plugin_name }}.cli:cli",
    "services": "chisurf.plugins.{{ cookiecutter.plugin_name }}.backend.services:register_services"
  },
  "rpc_methods": [
    {
      "name": "{{ cookiecutter.plugin_name }}.ping",
      "summary": "Liveness check."
    },
    {
      "name": "{{ cookiecutter.plugin_name }}.compute",
      "summary": "Compute the example result of a PluginSettings dict."
    }
  ],
  "events": [],
  "dependencies": {},
  "requires": {},
  "optional_requires": {},
  "menu_hidden": false,
  "deprecated": false
}
