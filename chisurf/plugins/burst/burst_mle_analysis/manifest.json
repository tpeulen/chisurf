{
  "id": "burst_mle_analysis",
  "version": "1.1.0",
  "display_name": "Spectroscopy:Single-Molecule:Burst MLE",
  "icon": "📈",
  "description": "Maximum likelihood lifetime analysis for single-molecule burst data.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Spectroscopy",
    "Single-Molecule"
  ],
  "state_namespace": "burst_mle_analysis",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "accepts": [
    {
      "name": "bursts",
      "summary": "Fit burst lifetimes to burst runs of measurement containers.",
      "receive": "chisurf.plugins.burst.burst_mle_analysis.gui.native:receive_bursts",
      "required": [
        "files"
      ],
      "from_workspace": {
        "kinds": [
          "bursts"
        ],
        "many": true,
        "key": "files"
      }
    },
    {
      "name": "irf_measurement",
      "summary": "Use measured IRF photon streams (scatter or a short-lifetime reference) for the current detector.",
      "receive": "chisurf.plugins.burst.burst_mle_analysis.gui.native:receive_irf",
      "required": [
        "files"
      ],
      "from_workspace": {
        "kinds": [
          "photons"
        ],
        "many": true,
        "key": "files"
      }
    },
    {
      "name": "background_measurement",
      "summary": "Use measured background photon streams (a sample-free measurement) for the current detector.",
      "receive": "chisurf.plugins.burst.burst_mle_analysis.gui.native:receive_background",
      "required": [
        "files"
      ],
      "from_workspace": {
        "kinds": [
          "photons"
        ],
        "many": true,
        "key": "files"
      }
    }
  ],
  "entrypoints": {
    "services": "chisurf.plugins.burst.burst_mle_analysis.backend.services:register_services",
    "emtk": "chisurf.plugins.burst.burst_mle_analysis.gui.native:create_app"
  },
  "operation_types": [
    "burst_lifetime_fitting",
    "calibration"
  ],
  "rpc_methods": [
    {
      "name": "burst_mle.workflow.prepare",
      "summary": "Resolve MLE burst files and channel definitions from workflow context.",
      "long_running": false
    },
    {
      "name": "burst_mle.contract.describe",
      "summary": "Return the Burst MLE workflow contract.",
      "long_running": false
    }
  ],
  "menu_hidden": true,
  "requires": {
    "pto_inspector": "*"
  },
  "optional_requires": {
    "burst_selection": "*"
  }
}
