{
  "id": "mfd_prepare",
  "version": "1.0.0",
  "display_name": "File:Data:MFD Prepare",
  "description": "Prepare a burst folder for multiparameter-fluorescence (MFD) analysis: resolve photon sources, verify channel counts, compute mean micro times, and inspect the preparation report.",
  "authors": [
    "tpeulen"
  ],
  "categories": [
    "File",
    "Data"
  ],
  "icon": "\ud83d\udccb",
  "state_namespace": "mfd_prepare",
  "state_schema": {
    "folder": {
      "type": "string",
      "default": ""
    }
  },
  "statefulness": {
    "enabled": false
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.burst.mfd_prepare.gui.app:make_app",
    "cli": "mfd-prepare=chisurf.plugins.burst.mfd_prepare.cli.main:cli",
    "services": "chisurf.plugins.burst.mfd_prepare.backend.services:register_services"
  },
  "operation_types": [],
  "rpc_methods": [
    {
      "name": "mfd_prepare.prepare",
      "summary": "Prepare a burst folder for MFD analysis.",
      "params_schema": "api.contract#/methods/0/params_schema",
      "result_schema": "api.contract#/methods/0/result_schema",
      "long_running": true,
      "cancelable": false
    },
    {
      "name": "mfd_prepare.describe",
      "summary": "Return the plugin contract descriptor.",
      "params_schema": {
        "type": "object"
      },
      "result_schema": {
        "type": "object"
      },
      "long_running": false,
      "cancelable": false
    }
  ],
  "accepts": [
    {
      "name": "bursts",
      "summary": "Prepare a burst run for the 2D MFD fit: a run of a measurement container in the project's analysis container.",
      "receive": "chisurf.plugins.burst.mfd_prepare.gui.app:receive_bursts",
      "required": [
        "folder"
      ],
      "from_workspace": {
        "kinds": [
          "bursts"
        ],
        "key": "folder"
      }
    }
  ]
}
