        }
      ],
      "hidden_when": {
        "attr": "has_result",
        "equals": false
      }
    },
    {
      "type": "panel",
      "title": "Photon sources",
      "n_col": 1,
      "sections": [
        {
          "type": "table",
          "name": "sources",
          "source": "source_rows",
          "columns_source": "source_columns",
          "editable": false,
          "height": 80,
          "description": "The photon files the bursts point into and where each was found."
        }
      ],
      "hidden_when": {
        "attr": "has_result",
        "equals": false
      }
    },
    {
      "type": "panel",
      "title": "Folder summary",
      "n_col": 1,
      "sections": [
        {
          "type": "table",
          "name": "summary",
