{
  "id": "burst_analysis",
  "version": "1.0.0",
  "display_name": "Spectroscopy:Single-Molecule:Burst Analysis",
  "icon": "💥",
  "description": "Integrated burst workflow with burst selection, BVA, burst MLE, burst browser, and background estimation.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Spectroscopy",
    "Single-Molecule"
  ],
  "state_namespace": "burst_analysis",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": "burst_analysis_window"
    }
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.burst.burst_analysis.gui.native:create_app"
  },
  "optional_requires": {
    "accurate_fret": "*",
    "burst_2cde": "*",
    "burst_background": "*",
    "burst_browser": "*",
    "burst_bva": "*",
    "burst_fcs_correlator": "*",
    "burst_fusion": "*",
    "burst_gs": "*",
    "burst_h2mm": "*",
    "burst_irf_bg": "*",
    "burst_mle_analysis": "*",
    "burst_selection": "*",
    "mmfdb_admin": "*"
  },
  "menu_hidden": false,
  "accepts": [
    {
      "name": "photons",
      "summary": "The workflow's measurements: photon streams of the Datasets workspace; the burst runs found become their children.",
      "receive": "chisurf.plugins.burst.burst_analysis.gui.native:receive_photons",
      "required": [
        "files"
      ],
      "from_workspace": {
        "kinds": [
          "photons"
        ],
        "many": true,
        "key": "files"
      }
    },
    {
      "name": "setup",
      "summary": "A detector/channel setup of the Datasets workspace, loaded into the workflow's Setup step.",
      "receive": "chisurf.plugins.burst.burst_analysis.gui.native:receive_setup",
      "required": [
        "setup_file"
      ],
      "from_workspace": {
        "kinds": [
          "setup"
        ],
        "key": "setup_file"
      }
    }
  ]
}
