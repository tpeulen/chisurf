{
  "id": "burst_fcs_correlator",
  "version": "1.0.0",
  "display_name": "Spectroscopy:Correlation:Burst-wise FCS",
  "description": "Compute fluorescence correlation functions on a per-burst basis from Burst-ID (.bst) / BUR files.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Spectroscopy",
    "Fluorescence Correlation Spectroscopy",
    "Correlation"
  ],
  "icon": "🌀",
  "state_namespace": "burst_fcs_correlator",
  "state_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "settings": {
        "type": "object"
      },
      "selected_pairs": {
        "type": "array"
      },
      "detector_setup": {
        "type": "string"
      }
    }
  },
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "accepts": [
    {
      "name": "bursts",
      "summary": "Correlate the photons of burst runs of measurement containers.",
      "receive": "chisurf.plugins.burst.burst_fcs_correlator.gui.app:receive_bursts",
      "required": [
        "files"
      ],
      "from_workspace": {
        "kinds": [
          "bursts"
        ],
        "many": true,
        "key": "files"
      }
    },
    {
      "name": "pairs",
      "summary": "Take the FCS channel pairs from a detector setup or channel-pairs file.",
      "receive": "chisurf.plugins.burst.burst_fcs_correlator.gui.app:receive_pairs",
      "required": [
        "file"
      ],
      "from_workspace": {
        "kinds": [
          "setup"
        ],
        "key": "file"
      }
    },
    {
      "name": "settings",
      "summary": "Correlator settings saved with Save settings (a setup row of the Datasets workspace).",
      "receive": "chisurf.plugins.burst.burst_fcs_correlator.gui.app:receive_settings",
      "required": [
        "settings"
      ],
      "from_workspace": {
        "kinds": [
          "setup"
        ],
        "many": false,
        "key": "settings"
      }
    }
  ],
  "entrypoints": {
    "cli": null,
    "services": "chisurf.plugins.burst.burst_fcs_correlator.backend.services:register_services",
    "emtk": "chisurf.plugins.burst.burst_fcs_correlator.gui.app:create_app"
  },
  "operation_types": [
    "burst_correlation"
  ],
  "rpc_methods": [
    {
      "name": "burst_fcs.parse_bst",
      "summary": "Parse a Burst-ID .bst file into TTTR path + burst ranges.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "burst_fcs.parse_bur",
      "summary": "Parse a BUR file into TTTR path + burst ranges.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "burst_fcs.fit_curve",
      "summary": "Fit a correlation curve (simple/MaxEnt) per settings.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "burst_fcs.fit_diffusion",
      "summary": "MaxEnt diffusion-time summary of a correlation curve.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "burst_fcs.fit_simple",
      "summary": "Single-component diffusion-time fit of a correlation curve.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "burst_fcs.correlate_file",
      "summary": "Correlate every burst x pair for one TTTR file.",
      "params_schema": {},
      "result_schema": {},
      "long_running": true,
      "cancelable": false
    }
  ],
  "events": [],
  "dependencies": {},
  "deprecated": false,
  "requires": {
    "pto_inspector": "*"
  },
  "optional_requires": {
    "burst_selection": "*"
  }
}
