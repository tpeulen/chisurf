{
  "id": "burst_browser",
  "version": "1.0.0",
  "display_name": "Spectroscopy:Single-Molecule:Burst Browser",
  "icon": "📇",
  "description": "Inspect burstwise analysis tables and plots.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Spectroscopy",
    "Single-Molecule"
  ],
  "state_namespace": "burst_browser",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "accepts": [
    {
      "name": "bursts",
      "summary": "Browse and gate a burst run: a run of a measurement container, or a legacy burst folder.",
      "receive": "chisurf.plugins.burst.burst_browser.gui.app:receive_bursts",
      "required": [
        "folder"
      ],
      "from_workspace": {
        "kinds": [
          "bursts"
        ],
        "key": "folder"
      }
    }
  ],
  "entrypoints": {
    "emtk": "chisurf.plugins.burst.burst_browser.gui.app:create_app"
  },
  "menu_hidden": true
}
