{
  "id": "burst_irf_bg",
  "version": "1.0.0",
  "display_name": "Spectroscopy:Single-Molecule:Burst IRF & Background",
  "icon": "📉",
  "description": "Extract a per-detector IRF and background rate from the non-burst photons of a single-molecule measurement, and feed them to the burst MLE lifetime fit.",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Spectroscopy",
    "Single-Molecule"
  ],
  "state_namespace": "burst_irf_bg",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "emtk": "chisurf.plugins.burst.burst_irf_bg.gui.app:create_app"
  },
  "requires": {
    "burst_background": "*"
  },
  "menu_hidden": true,
  "accepts": [
    {
      "name": "photons",
      "summary": "Estimate the background (and IRF) from the non-burst photons of photon streams of the Datasets workspace.",
      "receive": "chisurf.plugins.burst.burst_irf_bg.gui.app:receive_photons",
      "required": [
        "files"
      ],
      "from_workspace": {
        "kinds": [
          "photons"
        ],
        "many": true,
        "key": "files"
      }
    }
  ]
}
