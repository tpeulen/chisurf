{
  "_comment": "Editor layout for the TCSPC MaxEntLifetimeModel (maximum-entropy lifetime distribution). The Convolution/Generic/Corrections/Anisotropy panels describe the same nuisance groups as lifetime.view.json -- keep them in step, a control added to only one is a parity gap between editors a user reads as the same. Model-specific: the entropy weight and the lifetime grid the distribution is recovered on, plus the L-curve the model already samples to pick that weight.",
  "sections": [
    {
      "type": "panel",
      "title": "Convolution",
      "sections": [
        {
          "type": "curve_input",
          "target": "convolve",
          "label": "IRF",
          "select_action": "model.change_irf",
          "unload_action": "model.unload_irf",
          "index_key": "irf_idx",
          "name_key": "irf_name",
          "name_attr": "irf"
        },
        {
          "type": "choice",
          "target": "convolve",
          "attr": "mode",
          "label": "Type",
          "options": [
            "per",
            "exp",
            "full"
          ],
          "style": "radio"
        },
        {
          "type": "toggle",
          "target": "convolve",
          "attr": "do_convolution",
          "label": "Convolve"
        },
        {
          "type": "parameter_group_table",
          "target": "convolve",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Generic",
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "generic",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "MaxEnt (lifetime)",
      "sections": [
        {
          "type": "parameter_group_table",
          "parameters_source": "_mem_parameter_rows",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "L-curve",
      "collapsed": true,
      "description": "Regularization sweep: the corner is the weight that balances misfit against solution smoothness.",
      "sections": [
        {
          "type": "custom",
          "key": "lcurve",
          "target": "l_curve",
          "description": "Run 'compute L-curve' to populate this; the detected corner is marked."
        }
      ]
    }
  ],
  "plots": [
    {
      "key": "line",
      "options": {
        "scale_x": "lin",
        "d_scaley": "log",
        "r_scaley": "lin",
        "x_label": "time (ns)",
        "y_label": "counts"
      }
    },
    {
      "key": "fit_table",
      "options": {}
    },
    {
      "key": "fit_info",
      "options": {}
    },
    {
      "key": "distribution",
      "options": {
        "distribution_options": {
          "Lifetime": {
            "attribute": "lifetime_spectrum",
            "accessor": "interleaved_to_two_columns",
            "accessor_kwargs": {
              "sort": true
            },
            "curve_options": {
              "stepMode": false,
              "connect": false,
              "bar_mode": "sticks",
              "symbol": "o"
            }
          }
        }
      }
    },
    {
      "key": "residual",
      "options": {}
    }
  ]
}
