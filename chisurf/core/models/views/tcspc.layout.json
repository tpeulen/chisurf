{
  "_comment": "How ChiSurf lays out the editor of a BFF-described TCSPC model: the panels the classic lifetime editor had (Convolution, Generic, Corrections, then the model's own groups, Anisotropy). Layout and labels only; what a family consists of is its BFF description. A family is laid out by this file when its name starts with a listed prefix. {n} in a label is the component number, counted from 1. scalar_labels shortens the description's labels for the compact panels. curves are drawn beside the model: a bound measurement at its own height, or else the node that models it. classic_editor mixes in the groups the classic view files address (chisurf.core.models.tcspc.classic_editor); names overrides the menu name of a family.",
  "applies_to": [
    "tcspc_"
  ],
  "labels": {
    "lifetime.amplitude": "x<sub>L,{n}</sub>",
    "lifetime.tau": "&tau;<sub>L,{n}</sub>",
    "donor.amplitude": "x<sub>L,{n}</sub>",
    "donor.tau": "&tau;<sub>L,{n}</sub>",
    "chromophore_a.amplitude": "x<sub>L,{n}</sub>",
    "chromophore_a.tau": "&tau;<sub>L,{n}</sub>",
    "rotation.amplitude": "b<sub>{n}</sub>",
    "rotation.time": "&rho;<sub>{n}</sub>",
    "distance.mean": "R<sub>DA,{n}</sub>",
    "distance.sigma": "w<sub>{n}</sub>",
    "distance.shape": "k<sub>{n}</sub>",
    "distance.amplitude": "x<sub>{n}</sub>",
    "mixture.fraction": "x<sub>{n}</sub>",
    "instrument.scatter": "sc",
    "instrument.background": "bg",
    "instrument.n0": "n<sub>0</sub>",
    "instrument.timeshift": "ts",
    "instrument.response_background": "lb",
    "instrument.irf_width": "IRF<sub>w</sub>",
    "instrument.irf_shape": "IRF<sub>k</sub>",
    "instrument.irf_position": "IRF<sub>pos</sub>",
    "anisotropy.r0": "r0",
    "anisotropy.g": "g",
    "anisotropy.l1": "l1",
    "anisotropy.l2": "l2",
    "fret.forster_radius": "R<sub>0</sub>",
    "fret.tau0": "&tau;<sub>0</sub>",
    "fret.kappa2": "&kappa;<sup>2</sup>",
    "fret.x_donly": "x<sub>D,0</sub>",
    "maxent.log10_nu": "log&#8321;&#8320;(&nu;)",
    "maxent.grid_from": "&tau;<sub>min</sub>",
    "maxent.grid_to": "&tau;<sub>max</sub>",
    "maxent.grid_bins": "&tau; bins"
  },
  "panels": [
    {
      "title": "Convolution",
      "datasets": [
        "response"
      ],
      "toggles": [
        "convolve",
        "periodic_excitation",
        "generated_response"
      ],
      "parameters": [
        "instrument.n0",
        "instrument.timeshift",
        "instrument.response_background",
        "instrument.irf_width",
        "instrument.irf_shape",
        "instrument.irf_position"
      ],
      "values": [
        "dt",
        "period"
      ]
    },
    {
      "title": "Generic",
      "datasets": [
        "background_pattern"
      ],
      "parameters": [
        "instrument.scatter",
        "instrument.background"
      ],
      "toggles": [
        "shift_background"
      ],
      "values": [
        "t_background",
        "t_decay"
      ]
    },
    {
      "title": "Corrections",
      "collapsed": true,
      "datasets": [
        "linearization",
        "linearization_curve"
      ],
      "toggles": [
        "pile_up",
        "reverse_linearization",
        "autoscale"
      ],
      "values": [
        "dead_time",
        "measurement_time",
        "lin_window_length"
      ],
      "choices": {
        "lin_window": {
          "label": "DNL window",
          "options": [
            "0.0",
            "1.0",
            "2.0",
            "3.0",
            "4.0"
          ],
          "labels": [
            "flat",
            "hanning",
            "hamming",
            "bartlett",
            "blackman"
          ]
        }
      }
    },
    {
      "groups": "*",
      "except": [
        "instrument",
        "anisotropy",
        "rotations"
      ]
    },
    {
      "title": "Anisotropy",
      "collapsed_unless_scalar": "polarization",
      "choices": {
        "polarization": {
          "label": "Polarization",
          "options": [
            "0.0",
            "1.0",
            "2.0",
            "3.0"
          ],
          "labels": [
            "VM",
            "VV",
            "VH",
            "VV/VH"
          ]
        }
      },
      "groups": [
        "anisotropy",
        "rotations"
      ],
      "custom": [
        "anisotropy_diagnostics"
      ]
    },
    {
      "title": "Settings",
      "collapsed": true,
      "values": "*"
    }
  ],
  "scalar_labels": {
    "convolve": "Convolve",
    "periodic_excitation": "Periodic",
    "generated_response": "Model IRF",
    "shift_background": "Shift bg with IRF",
    "pile_up": "Pile-up",
    "reverse_linearization": "Reverse DNL",
    "autoscale": "Autoscale n<sub>0</sub>",
    "lin_window_length": "DNL window [ch]",
    "dt": "dt [ns]",
    "period": "Period [ns]",
    "t_background": "t<sub>bg</sub> [s]",
    "t_decay": "t<sub>decay</sub> [s]",
    "dead_time": "t<sub>dead</sub> [ns]",
    "measurement_time": "t<sub>meas</sub> [s]"
  },
  "curves": {
    "IRF": {
      "dataset": "response",
      "node": "generated_response"
    }
  },
  "classic_editor": true,
  "names": {
    "tcspc_polarized": "Lifetime",
    "tcspc_lifetime": "Lifetime (magic angle only)"
  },
  "family_labels": {
    "tcspc_maxent_fret": {
      "maxent.grid_from": "r<sub>min</sub>",
      "maxent.grid_to": "r<sub>max</sub>",
      "maxent.grid_bins": "r bins"
    }
  }
}
