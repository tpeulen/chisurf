{
  "_comment": "Editor layout for the general composable FCS model (GeneralFCSModel). PRD-62: pick a diffusion type (Gauss, MDF, or two-focus Gauss, each also taking bunching/anticorrelation relaxation terms). The diffusion_mode choice carries rebuild_on_change, so picking a mode schedules a deferred AutoForm.rebuild(); each diffusion panel's collapsed_when (not_equals its own mode) then re-folds live — only the active mode's panel stays expanded.",
  "sections": [
    {
      "type": "panel",
      "title": "Diffusion",
      "collapsible": false,
      "sections": [
        {"type": "choice", "attr": "diffusion_mode", "label": "Type",
         "options": ["mdf", "gauss", "two_focus"], "labels": ["MDF", "Gauss", "Two-focus"], "style": "radio",
         "rebuild_on_change": true,
         "description": "MDF = Enderlein Gauss-Lorentz molecule-detection function (accurate absolute Veff/concentration). Gauss = classic single-focus 3D-Gaussian PSF approximation (the default). Two-focus = classic Dertinger dual-focus technique (same 3D-Gaussian term, known inter-focus distance yields an absolute D)."}
      ]
    },
    {
      "type": "panel",
      "title": "Equation",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {"type": "info", "source": "equation_html",
         "description": "The compound fitting equation currently active: the selected diffusion term times any active bunching/anticorrelation factors."}
      ]
    },
    {
      "type": "panel",
      "title": "MDF (Gauss-Lorentz)",
      "collapsible": true,
      "collapsed": false,
      "collapsed_when": {"attr": "diffusion_mode", "not_equals": "mdf"},
      "sections": [
        {"type": "parameter_group_table", "target": "mdf_physical", "collapsible": false},
        {"type": "parameter_group_table", "target": "mdf_optics", "collapsible": false}
      ]
    },
    {
      "type": "panel",
      "title": "3D Gaussian (single-focus)",
      "collapsible": true,
      "collapsed": false,
      "collapsed_when": {"attr": "diffusion_mode", "not_equals": "gauss"},
      "sections": [
        {"type": "parameter_group_table", "target": "gauss", "collapsible": false}
      ]
    },
    {
      "type": "panel",
      "title": "3D Gaussian (two-focus)",
      "collapsible": true,
      "collapsed": false,
      "collapsed_when": {"attr": "diffusion_mode", "not_equals": "two_focus"},
      "sections": [
        {"type": "parameter_group_table", "target": "two_focus", "collapsible": false}
      ]
    },
    {
      "type": "panel",
      "title": "Bunching terms",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {
          "type": "dynamic_group",
          "target": "bunching",
          "append_method": "add_bunching",
          "remove_method": "remove_bunching",
          "rows_source": "_bunching_parameter_rows",
          "row_width": 2,
          "style": "table",
          "min_rows": 0,
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Anticorr terms",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {
          "type": "dynamic_group",
          "target": "anticorr",
          "append_method": "add_anticorr",
          "remove_method": "remove_anticorr",
          "rows_source": "_anticorr_parameter_rows",
          "row_width": 2,
          "style": "table",
          "min_rows": 0,
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Outputs (MDF mode)",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {"type": "parameter_group_table", "target": "mdf_outputs", "collapsible": false}
      ]
    }
  ],
  "plots": [
    {"key": "line", "options": {"scale_x": "log", "d_scaley": "lin", "r_scaley": "lin", "x_label": "t_c (ms)", "y_label": "G_c(t_c)"}},
    {"key": "fit_table", "options": {}},
    {"key": "fit_info", "options": {}},
    {"key": "parameter_scan", "options": {}},
    {"key": "residual", "options": {}}
  ]
}
