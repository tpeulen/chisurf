{
  "_comment": "Editor layout for the 3D-Rice DEER model (DeerRiceModel). Compute stays in deer.py; this JSON is user-editable.",
  "sections": [
    {
      "type": "panel",
      "title": "Distance (Rice)",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "rice",
          "collapsible": false
        }
      ],
      "description": "Rice-distribution components of P(r): mean distance (nm), width sigma (nm) and amplitude."
    },
    {
      "type": "panel",
      "title": "Modulation",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "modulation",
          "collapsible": false
        }
      ],
      "description": "Modulation depth lambda and its settings: fraction of spins excited by the pump pulse (0-1)."
    },
    {
      "type": "panel",
      "title": "Background",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {
          "type": "choice",
          "target": "background",
          "attr": "model",
          "label": "Model",
          "options": [
            "hom3d",
            "exp",
            "strexp"
          ],
          "description": "Functional form of the intermolecular background: hom3d = homogeneous 3-D, exp = exponential, strexp = stretched exponential."
        },
        {
          "type": "parameter_group_table",
          "target": "background",
          "collapsible": false
        }
      ],
      "description": "Intermolecular background decay (exp, stretched exp or homogeneous 3-D) divided out of the DEER signal; its decay rate/dimension is fitted."
    },
    {
      "type": "panel",
      "title": "Distance grid",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "grid",
          "collapsible": false
        }
      ],
      "description": "Distance axis r (nm) on which P(r) is evaluated: range and number of points."
    }
  ],
  "plots": [
    {
      "key": "line",
      "options": {
        "scale_x": "lin",
        "d_scaley": "lin",
        "r_scaley": "lin",
        "x_label": "t (\u00b5s)",
        "y_label": "V(t)"
      }
    },
    {
      "key": "distribution",
      "options": {
        "distribution_options": {
          "r (\u00c5)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.deer.common:get_deer_distance_distribution",
            "curve_options": {
              "stepMode": false,
              "connect": "all"
            }
          }
        }
      }
    },
    {
      "key": "pr_ci",
      "options": {}
    },
    {
      "key": "fit_info",
      "options": {}
    },
    {
      "key": "parameter_scan",
      "options": {}
    },
    {
      "key": "residual",
      "options": {}
    }
  ]
}
