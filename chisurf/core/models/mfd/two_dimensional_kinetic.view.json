{
  "sections": [
    {
      "type": "info",
      "source": "summary_html"
    },
    {
      "type": "panel",
      "title": "States",
      "collapsed": false,
      "sections": [
        {
          "type": "dynamic_group",
          "target": "state_group",
          "rows_source": "distance_rows",
          "row_width": 2,
          "append_method": "append",
          "remove_method": "pop",
          "min_rows": 2,
          "description": "One row per exchanging state: its mean donor-acceptor distance in Angstrom, and its equilibrium population. Adding or removing a state resizes the rate matrix with it."
        },
        {
          "type": "parameter_group_table",
          "target": "state_group",
          "description": "The donor-only fraction does not take part in the exchange: a molecule with no active acceptor has no FRET state to be in."
        }
      ]
    },
    {
      "type": "panel",
      "title": "Exchange",
      "collapsed": false,
      "sections": [
        {
          "type": "custom",
          "key": "rate_matrix",
          "target": "rate_values",
          "title": "Rate matrix",
          "options": {
            "size_attr": "n_states",
            "labels_attr": "state_names",
            "minimum": 0.0,
            "maximum": 1000000.0,
            "decimals": 3,
            "diagonal": false,
            "unit": "1/s"
          },
          "description": "Exchange rates between states, in inverse seconds. A rate far below one transition per burst is the static mixture; far above it, the states merge into one averaged population. Between the two, bursts caught mid-exchange fill the space between the states and pull the cloud off the static line, which is the signal being fitted."
        }
      ]
    },
    {
      "type": "panel",
      "title": "Calibration",
      "collapsed": true,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "calibration",
          "description": "Correction factors and dye constants. All of them act inside the forward model, never on the data histogram, which is what lets any of them be freed without the fit's target moving underneath it."
        }
      ]
    }
  ],
  "plots": [
    {
      "key": "mfd_map",
      "options": {
        "target": "mfd_image",
        "colormap": true,
        "default_colormap": "inferno",
        "colormap_attr": "image_colormap",
        "extent_source": "mfd_image_extent",
        "channel_source": "mfd_image_channels",
        "channel_attr": "image_channel",
        "channel_call": "set_mfd_image_channel",
        "invert_y": false,
        "aspect_locked": false,
        "axes_visible": true,
        "x_label": "proximity ratio",
        "y_label": "\u27e8t\u27e9 / ns"
      }
    },
    {
      "key": "mfd_marginals",
      "options": {}
    },
    {
      "key": "fit_info",
      "options": {}
    },
    {
      "key": "residual2d",
      "options": {
        "accessor": "chisurf.core.models.mfd.two_dimensional:get_mfd_residual_image",
        "accessor_kwargs": {
          "weighted": true
        }
      }
    },
    {
      "key": "parameter_scan",
      "options": {}
    }
  ]
}
