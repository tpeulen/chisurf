{
  "_comment": "Editor layout for the TCSPC FRETrateModel (FRET: FD (Discrete)). The Convolution/Generic/Corrections/Anisotropy panels describe the same nuisance groups as lifetime.view.json -- keep them in step, a control added to only one is a parity gap between editors a user reads as the same. FRET-specific: the donor decay, the FRET parameters with the kappa2 control row, and a set of discrete donor-acceptor distances each with an amplitude.",
  "sections": [
    {
      "type": "panel",
      "title": "Convolution",
      "sections": [
        {
          "type": "curve_input",
          "target": "convolve",
          "label": "IRF",
          "select_action": "model.change_irf",
          "unload_action": "model.unload_irf",
          "index_key": "irf_idx",
          "name_key": "irf_name",
          "name_attr": "irf"
        },
        {
          "type": "choice",
          "target": "convolve",
          "attr": "mode",
          "label": "Type",
          "options": [
            "per",
            "exp",
            "full"
          ],
          "style": "radio"
        },
        {
          "type": "toggle",
          "target": "convolve",
          "attr": "do_convolution",
          "label": "Convolve"
        },
        {
          "type": "parameter_group_table",
          "target": "convolve",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Generic",
      "sections": [
        {
          "type": "curve_input",
          "target": "generic",
          "label": "Background",
          "select_action": "model.set_background_curve",
          "unload_action": "model.unload_background_curve",
          "index_key": "idx",
          "name_key": "curve_name",
          "name_attr": "background_curve"
        },
        {
          "type": "parameter_group_table",
          "target": "generic",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Corrections",
      "collapsed": true,
      "sections": [
        {
          "type": "curve_input",
          "target": "corrections",
          "label": "Lin. table",
          "select_action": "model.set_linearization",
          "unload_action": "model.unload_lintable",
          "index_key": "idx",
          "name_key": "lin_name"
        },
        {
          "type": "choice",
          "target": "corrections",
          "attr": "window_function",
          "label": "Smoothing",
          "options_source": "window_function_types"
        },
        {
          "type": "toggle_row",
          "items": [
            {
              "target": "corrections",
              "attr": "correct_pile_up",
              "label": "Pile-up"
            },
            {
              "target": "corrections",
              "attr": "correct_dnl",
              "label": "DNL"
            },
            {
              "target": "corrections",
              "attr": "reverse",
              "label": "Reverse"
            }
          ]
        },
        {
          "type": "parameter_group_table",
          "target": "corrections",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Donor",
      "description": "Fluorescence decay of the donor in the absence of FRET.",
      "sections": [
        {
          "type": "dynamic_group",
          "target": "lifetimes",
          "rows_source": "_lifetime_parameter_rows",
          "row_width": 2,
          "style": "table",
          "header_keys": [
            "lifetime_amplitude_options"
          ],
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "FRET parameters",
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "fret_parameters",
          "collapsible": false
        },
        {
          "type": "custom",
          "key": "kappa2_controls",
          "description": "Orientation factor: dynamic averaging uses the scalar kappa-squared, static averaging uses its distribution. 'show' plots the current distribution, 'compute' derives one from anisotropies, 'calc R0' opens the Foerster-radius calculator."
        }
      ]
    },
    {
      "type": "panel",
      "title": "Discrete distances",
      "sections": [
        {
          "type": "dynamic_group",
          "target": "fret_rates",
          "rows_source": "_distance_parameter_rows",
          "append_method": "append_distance",
          "remove_method": "pop",
          "row_width": 2,
          "style": "table",
          "min_rows": 1,
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Anisotropy",
      "collapsed_when": {
        "target": "anisotropy",
        "attr": "polarization_type",
        "equals": "vm"
      },
      "sections": [
        {
          "type": "choice",
          "target": "anisotropy",
          "attr": "polarization_type",
          "label": "Polarization",
          "options": [
            "vm",
            "vv",
            "vh",
            "vv/vh"
          ]
        },
        {
          "type": "parameter_group_table",
          "target": "anisotropy",
          "exclude_source": "_rotation_parameters",
          "collapsible": false
        },
        {
          "type": "dynamic_group",
          "target": "anisotropy",
          "append_method": "add_rotation",
          "remove_method": "remove_rotation",
          "rows_source": "_rotation_parameter_rows",
          "row_width": 2,
          "style": "table",
          "min_rows": 0,
          "collapsible": false
        },
        {
          "type": "custom",
          "key": "anisotropy_diagnostics",
          "target": "anisotropy",
          "description": "Background-corrected VV/VH integrals, and r(t) for data and model with the correction factors as live controls."
        }
      ]
    }
  ],
  "plots": [
    {
      "key": "line",
      "options": {
        "scale_x": "lin",
        "d_scaley": "log",
        "r_scaley": "lin",
        "x_label": "time (ns)",
        "y_label": "counts"
      }
    },
    {
      "key": "fit_table",
      "options": {}
    },
    {
      "key": "fit_info",
      "options": {}
    },
    {
      "key": "parameter_scan",
      "options": {}
    },
    {
      "key": "distribution",
      "options": {
        "distribution_options": {
          "Distance": {
            "attribute": "distance_distribution",
            "accessor": "first_distribution_pair",
            "accessor_kwargs": {
              "sort": false
            },
            "curve_options": {
              "symbol": "t",
              "bar_mode": "sticks"
            }
          },
          "FRET-rate constant": {
            "attribute": "fret_rate_spectrum",
            "accessor": "interleaved_to_two_columns",
            "accessor_kwargs": {
              "sort": true
            },
            "curve_options": {
              "symbol": "o"
            }
          },
          "Lifetime": {
            "attribute": "lifetime_spectrum",
            "accessor": "interleaved_to_two_columns",
            "accessor_kwargs": {
              "sort": true
            },
            "curve_options": {
              "symbol": "o"
            }
          }
        }
      }
    },
    {
      "key": "residual",
      "options": {}
    }
  ]
}
