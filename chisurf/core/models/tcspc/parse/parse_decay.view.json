{
  "_comment": "Editor layout for the TCSPC ParseDecayModel (a user-supplied decay equation). The equation catalogue lives in core (ParseModel.catalogue), so the picker is a plain `choice` over `catalogue_names` writing `model_name` -- no bespoke section. `rebuild_on_change` matters: a different equation has different parameters, so the table below must be rebuilt, not refreshed. The Convolution/Generic/Corrections panels are the same nuisance groups as lifetime.view.json -- keep them in step.",
  "sections": [
    {
      "type": "panel",
      "title": "Equation",
      "sections": [
        {
          "type": "choice",
          "attr": "model_name",
          "label": "Model",
          "options_source": "catalogue_names",
          "rebuild_on_change": true,
          "description": "Pick an equation from the catalogue; its initial parameter values are applied with it."
        },
        {
          "type": "value",
          "attr": "func",
          "kind": "expression",
          "label": "f(x)",
          "description": "The equation, in Python syntax. Every free name becomes a fitted parameter. Committed when you leave the field."
        },
        {
          "type": "info",
          "source": "description",
          "is_markdown": false,
          "max_height": 90
        }
      ]
    },
    {
      "type": "panel",
      "title": "Equation parameters",
      "sections": [
        {
          "type": "parameter_group_table",
          "parameters_source": "_parameters_equation",
          "collapsible": false,
          "description": "One row per free name in the equation."
        }
      ]
    },
    {
      "type": "panel",
      "title": "Convolution",
      "sections": [
        {
          "type": "curve_input",
          "target": "convolve",
          "label": "IRF",
          "select_action": "model.change_irf",
          "unload_action": "model.unload_irf",
          "index_key": "irf_idx",
          "name_key": "irf_name",
          "name_attr": "irf"
        },
        {
          "type": "choice",
          "target": "convolve",
          "attr": "mode",
          "label": "Type",
          "options": [
            "per",
            "exp",
            "full"
          ],
          "style": "radio"
        },
        {
          "type": "toggle",
          "target": "convolve",
          "attr": "do_convolution",
          "label": "Convolve"
        },
        {
          "type": "parameter_group_table",
          "target": "convolve",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Generic",
      "sections": [
        {
          "type": "curve_input",
          "target": "generic",
          "label": "Background",
          "select_action": "model.set_background_curve",
          "unload_action": "model.unload_background_curve",
          "index_key": "idx",
          "name_key": "curve_name",
          "name_attr": "background_curve"
        },
        {
          "type": "parameter_group_table",
          "target": "generic",
          "collapsible": false
        },
        {
          "type": "value",
          "target": "generic",
          "attr": "n_ph_bg",
          "kind": "float",
          "read_only": true,
          "label": "#PhB",
          "decimals": 0
        },
        {
          "type": "value",
          "target": "generic",
          "attr": "n_ph_fl",
          "kind": "float",
          "read_only": true,
          "label": "#PhF",
          "decimals": 0
        }
      ]
    },
    {
      "type": "panel",
      "title": "Corrections",
      "collapsed": true,
      "sections": [
        {
          "type": "curve_input",
          "target": "corrections",
          "label": "Lin. table",
          "select_action": "model.set_linearization",
          "unload_action": "model.unload_lintable",
          "index_key": "idx",
          "name_key": "lin_name"
        },
        {
          "type": "choice",
          "target": "corrections",
          "attr": "window_function",
          "label": "Smoothing",
          "options_source": "window_function_types"
        },
        {
          "type": "toggle_row",
          "items": [
            {
              "target": "corrections",
              "attr": "correct_pile_up",
              "label": "Pile-up"
            },
            {
              "target": "corrections",
              "attr": "correct_dnl",
              "label": "DNL"
            },
            {
              "target": "corrections",
              "attr": "reverse",
              "label": "Reverse"
            }
          ]
        },
        {
          "type": "parameter_group_table",
          "target": "corrections",
          "collapsible": false
        }
      ]
    }
  ],
  "plots": [
    {
      "key": "line",
      "options": {
        "scale_x": "lin",
        "d_scaley": "log",
        "r_scaley": "lin",
        "x_label": "time (ns)",
        "y_label": "counts"
      }
    },
    {
      "key": "fit_table",
      "options": {}
    },
    {
      "key": "fit_info",
      "options": {}
    },
    {
      "key": "parameter_scan",
      "options": {}
    },
    {
      "key": "residual",
      "options": {}
    }
  ]
}
