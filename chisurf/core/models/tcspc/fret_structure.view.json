{
  "_comment": "Editor layout for the TCSPC FRETStructure model (FRET: Structure fit). The Convolution/Generic/Corrections/Anisotropy panels describe the same nuisance groups as lifetime.view.json -- keep them in step, a control added to only one is a parity gap between editors a user reads as the same. Model-specific: the accessible-volume geometry of the two dyes, the PDB ensemble (dropping files rebuilds it -- the path_list writes structure_files and the model reloads), and one fitted fraction per structure.",
  "sections": [
    {
      "type": "panel",
      "title": "Convolution",
      "sections": [
        {
          "type": "curve_input",
          "target": "convolve",
          "label": "IRF",
          "select_action": "model.change_irf",
          "unload_action": "model.unload_irf",
          "index_key": "irf_idx",
          "name_key": "irf_name",
          "name_attr": "irf"
        },
        {
          "type": "choice",
          "target": "convolve",
          "attr": "mode",
          "label": "Type",
          "options": [
            "per",
            "exp",
            "full"
          ],
          "style": "radio"
        },
        {
          "type": "toggle",
          "target": "convolve",
          "attr": "do_convolution",
          "label": "Convolve"
        },
        {
          "type": "parameter_group_table",
          "target": "convolve",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Generic",
      "sections": [
        {
          "type": "curve_input",
          "target": "generic",
          "label": "Background",
          "select_action": "model.set_background_curve",
          "unload_action": "model.unload_background_curve",
          "index_key": "idx",
          "name_key": "curve_name",
          "name_attr": "background_curve"
        },
        {
          "type": "parameter_group_table",
          "target": "generic",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Corrections",
      "collapsed": true,
      "sections": [
        {
          "type": "curve_input",
          "target": "corrections",
          "label": "Lin. table",
          "select_action": "model.set_linearization",
          "unload_action": "model.unload_lintable",
          "index_key": "idx",
          "name_key": "lin_name"
        },
        {
          "type": "choice",
          "target": "corrections",
          "attr": "window_function",
          "label": "Smoothing",
          "options_source": "window_function_types"
        },
        {
          "type": "toggle_row",
          "items": [
            {
              "target": "corrections",
              "attr": "correct_pile_up",
              "label": "Pile-up"
            },
            {
              "target": "corrections",
              "attr": "correct_dnl",
              "label": "DNL"
            },
            {
              "target": "corrections",
              "attr": "reverse",
              "label": "Reverse"
            }
          ]
        },
        {
          "type": "parameter_group_table",
          "target": "corrections",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Donor",
      "description": "Fluorescence decay of the donor in the absence of FRET.",
      "sections": [
        {
          "type": "dynamic_group",
          "target": "lifetimes",
          "rows_source": "_lifetime_parameter_rows",
          "row_width": 2,
          "style": "table",
          "header_keys": [
            "lifetime_amplitude_options"
          ],
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "FRET parameters",
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "fret_parameters",
          "collapsible": false
        },
        {
          "type": "custom",
          "key": "kappa2_controls",
          "description": "Orientation factor: dynamic averaging uses the scalar kappa-squared, static averaging uses its distribution. 'show' plots the current distribution, 'compute' derives one from anisotropies, 'calc R0' opens the Foerster-radius calculator."
        }
      ]
    },
    {
      "type": "panel",
      "title": "Labels / AV",
      "sections": [
        {
          "type": "panel",
          "title": "Donor label",
          "description": "Accessible-volume geometry of the donor dye: where it is attached and how far it can reach.",
          "sections": [
            {
              "type": "value",
              "attr": "res_1",
              "label": "Residue",
              "kind": "int",
              "description": "Sequence number of the residue the donor is attached to."
            },
            {
              "type": "value",
              "attr": "atom_name_1",
              "label": "Atom",
              "kind": "str",
              "description": "Atom of that residue the linker starts from (CA by default)."
            },
            {
              "type": "value",
              "attr": "linker_length_1",
              "label": "Linker length",
              "kind": "float",
              "description": "Contour length of the dye linker in Angstrom.",
              "suffix": " \u00c5"
            },
            {
              "type": "value",
              "attr": "linker_width_1",
              "label": "Linker width",
              "kind": "float",
              "description": "Width of the dye linker in Angstrom.",
              "suffix": " \u00c5"
            },
            {
              "type": "value",
              "attr": "radius1_1",
              "label": "Radius 1",
              "kind": "float",
              "description": "Radius of the dye sphere in Angstrom.",
              "suffix": " \u00c5"
            },
            {
              "type": "value",
              "attr": "radius2_1",
              "label": "Radius 2",
              "kind": "float",
              "suffix": " \u00c5",
              "description": "Second AV3 sphere radius."
            },
            {
              "type": "value",
              "attr": "radius3_1",
              "label": "Radius 3",
              "kind": "float",
              "suffix": " \u00c5",
              "description": "Third AV3 sphere radius."
            }
          ]
        },
        {
          "type": "panel",
          "title": "Acceptor label",
          "description": "Accessible-volume geometry of the acceptor dye: where it is attached and how far it can reach.",
          "sections": [
            {
              "type": "value",
              "attr": "res_2",
              "label": "Residue",
              "kind": "int",
              "description": "Sequence number of the residue the acceptor is attached to."
            },
            {
              "type": "value",
              "attr": "atom_name_2",
              "label": "Atom",
              "kind": "str",
              "description": "Atom of that residue the linker starts from (CA by default)."
            },
            {
              "type": "value",
              "attr": "linker_length_2",
              "label": "Linker length",
              "kind": "float",
              "description": "Contour length of the dye linker in Angstrom.",
              "suffix": " \u00c5"
            },
            {
              "type": "value",
              "attr": "linker_width_2",
              "label": "Linker width",
              "kind": "float",
              "description": "Width of the dye linker in Angstrom.",
              "suffix": " \u00c5"
            },
            {
              "type": "value",
              "attr": "radius1_2",
              "label": "Radius 1",
              "kind": "float",
              "description": "Radius of the dye sphere in Angstrom.",
              "suffix": " \u00c5"
            },
            {
              "type": "value",
              "attr": "radius2_2",
              "label": "Radius 2",
              "kind": "float",
              "suffix": " \u00c5",
              "description": "Second AV3 sphere radius."
            },
            {
              "type": "value",
              "attr": "radius3_2",
              "label": "Radius 3",
              "kind": "float",
              "suffix": " \u00c5",
              "description": "Third AV3 sphere radius."
            }
          ]
        },
        {
          "type": "value",
          "attr": "simulation_grid_resolution",
          "label": "Resolution",
          "kind": "float",
          "suffix": " \u00c5",
          "description": "Spacing of the accessible-volume simulation grid; smaller is finer and slower. Shared by both dyes."
        }
      ]
    },
    {
      "type": "panel",
      "title": "Structures",
      "sections": [
        {
          "type": "custom",
          "key": "path_list",
          "target": "structure_files",
          "options": {
            "extensions": [
              ".pdb"
            ],
            "add_folders": true,
            "dialog_filter": "PDB files (*.pdb)",
            "title": "PDB ensemble"
          },
          "description": "Drop PDB files or a folder; the ensemble and its fractions rebuild from this list."
        },
        {
          "type": "dynamic_group",
          "rows_source": "_fraction_parameter_rows",
          "row_width": 1,
          "style": "table",
          "min_rows": 0,
          "collapsible": false,
          "description": "One fitted fraction per structure; the row count follows the file list.",
          "title": "Fractions"
        }
      ]
    },
    {
      "type": "panel",
      "title": "Anisotropy",
      "collapsed_when": {
        "target": "anisotropy",
        "attr": "polarization_type",
        "equals": "vm"
      },
      "sections": [
        {
          "type": "choice",
          "target": "anisotropy",
          "attr": "polarization_type",
          "label": "Polarization",
          "options": [
            "vm",
            "vv",
            "vh",
            "vv/vh"
          ]
        },
        {
          "type": "parameter_group_table",
          "target": "anisotropy",
          "exclude_source": "_rotation_parameters",
          "collapsible": false
        },
        {
          "type": "dynamic_group",
          "target": "anisotropy",
          "append_method": "add_rotation",
          "remove_method": "remove_rotation",
          "rows_source": "_rotation_parameter_rows",
          "row_width": 2,
          "style": "table",
          "min_rows": 0,
          "collapsible": false
        },
        {
          "type": "custom",
          "key": "anisotropy_diagnostics",
          "target": "anisotropy",
          "description": "Background-corrected VV/VH integrals, and r(t) for data and model with the correction factors as live controls."
        }
      ]
    }
  ],
  "plots": [
    {
      "key": "line",
      "options": {
        "scale_x": "lin",
        "d_scaley": "log",
        "r_scaley": "lin",
        "x_label": "time (ns)",
        "y_label": "counts"
      }
    },
    {
      "key": "fit_table",
      "options": {}
    },
    {
      "key": "fit_info",
      "options": {}
    },
    {
      "key": "parameter_scan",
      "options": {}
    },
    {
      "key": "distribution",
      "options": {
        "distribution_options": {
          "Distance": {
            "attribute": "distance_distribution",
            "accessor": "first_distribution_pair",
            "accessor_kwargs": {
              "sort": false
            },
            "curve_options": {
              "symbol": "t",
              "bar_mode": "sticks"
            }
          },
          "FRET-rate constant": {
            "attribute": "fret_rate_spectrum",
            "accessor": "interleaved_to_two_columns",
            "accessor_kwargs": {
              "sort": true
            },
            "curve_options": {
              "symbol": "o"
            }
          },
          "Lifetime": {
            "attribute": "lifetime_spectrum",
            "accessor": "interleaved_to_two_columns",
            "accessor_kwargs": {
              "sort": true
            },
            "curve_options": {
              "symbol": "o"
            }
          }
        }
      }
    },
    {
      "key": "residual",
      "options": {}
    }
  ]
}
