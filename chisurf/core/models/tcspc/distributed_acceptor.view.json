{
 "_comment": "Editor layout for the TCSPC DistributedAcceptorModel (FRET: distributed acceptors). The Convolution/Generic/Corrections/Lifetimes panels are copied from lifetime.view.json -- keep them in step, a control added to only one is a parity gap between editors a user reads as the same. There is deliberately NO Anisotropy panel: the polarized channels are built from a lifetime spectrum and this model's decay is not a finite mixture of exponentials, so it fits magic-angle or total decays only. Model-specific: the acceptor density C/C0, the dimensionality, and the R0/tauD0 the density is expressed against.",
 "sections": [
  {
   "type": "panel",
   "title": "Convolution",
   "sections": [
    {
     "type": "curve_input",
     "target": "convolve",
     "label": "IRF",
     "select_action": "model.change_irf",
     "unload_action": "model.unload_irf",
     "index_key": "irf_idx",
     "name_key": "irf_name",
     "name_attr": "irf"
    },
    {
     "type": "choice",
     "target": "convolve",
     "attr": "mode",
     "label": "Type",
     "options": [
      "per",
      "exp",
      "full"
     ],
     "style": "radio"
    },
    {
     "type": "toggle",
     "target": "convolve",
     "attr": "do_convolution",
     "label": "Convolve"
    },
    {
     "type": "parameter_group_table",
     "target": "convolve",
     "collapsible": false
    }
   ]
  },
  {
   "type": "panel",
   "title": "Generic",
   "sections": [
    {
     "type": "curve_input",
     "target": "generic",
     "label": "Background",
     "select_action": "model.set_background_curve",
     "unload_action": "model.unload_background_curve",
     "index_key": "idx",
     "name_key": "curve_name",
     "name_attr": "background_curve"
    },
    {
     "type": "parameter_group_table",
     "target": "generic",
     "collapsible": false
    },
    {
     "type": "value",
     "target": "generic",
     "attr": "n_ph_bg",
     "kind": "float",
     "read_only": true,
     "label": "#PhB",
     "decimals": 0
    },
    {
     "type": "value",
     "target": "generic",
     "attr": "n_ph_fl",
     "kind": "float",
     "read_only": true,
     "label": "#PhF",
     "decimals": 0
    }
   ]
  },
  {
   "type": "panel",
   "title": "Corrections",
   "collapsed": true,
   "sections": [
    {
     "type": "curve_input",
     "target": "corrections",
     "label": "Lin. table",
     "select_action": "model.set_linearization",
     "unload_action": "model.unload_lintable",
     "index_key": "idx",
     "name_key": "lin_name"
    },
    {
     "type": "choice",
     "target": "corrections",
     "attr": "window_function",
     "label": "Smoothing",
     "options_source": "window_function_types"
    },
    {
     "type": "toggle_row",
     "items": [
      {
       "target": "corrections",
       "attr": "correct_pile_up",
       "label": "Pile-up"
      },
      {
       "target": "corrections",
       "attr": "correct_dnl",
       "label": "DNL"
      },
      {
       "target": "corrections",
       "attr": "reverse",
       "label": "Reverse"
      }
     ]
    },
    {
     "type": "parameter_group_table",
     "target": "corrections",
     "collapsible": false
    }
   ]
  },
  {
   "type": "panel",
   "title": "Lifetimes",
   "sections": [
    {
     "type": "dynamic_group",
     "target": "lifetimes",
     "rows_source": "_lifetime_parameter_rows",
     "row_width": 2,
     "style": "table",
     "header_keys": [
      "lifetime_amplitude_options"
     ],
     "collapsible": false
    }
   ]
  },
  {
   "type": "panel",
   "title": "Distributed acceptors",
   "sections": [
    {
     "type": "choice",
     "attr": "dimension",
     "label": "Dimensionality",
     "options": [
      3,
      2,
      1
     ],
     "labels": [
      "3-D (solution)",
      "2-D (membrane)",
      "1-D (helix)"
     ],
     "style": "radio",
     "description": "Geometry the acceptors occupy. Sets the stretch exponent d/6 of the decay, so the three cases are distinguishable in the fit."
    },
    {
     "type": "parameter_group_table",
     "collapsible": false,
     "description": "C/C0 is the number of acceptors within R0 of a donor -- the fitted quantity. R0 and tauD0 are inputs: they define C0, so changing them rescales the density rather than improving the fit.",
     "parameters_source": "_density_parameter_rows"
    },
    {
     "type": "info",
     "source": "derived_html",
     "max_height": 40,
     "description": "Transfer efficiency and absolute acceptor density implied by the fitted C/C0 -- computed, not fitted, so neither carries an error bar of its own."
    }
   ]
  }
 ],
 "plots": [
  {
   "key": "line",
   "options": {
    "scale_x": "lin",
    "d_scaley": "log",
    "r_scaley": "lin",
    "x_label": "time (ns)",
    "y_label": "counts"
   }
  },
  {
   "key": "fit_table",
   "options": {}
  },
  {
   "key": "fit_info",
   "options": {}
  },
  {
   "key": "parameter_scan",
   "options": {}
  },
  {
   "key": "distribution",
   "options": {
    "distribution_options": {
     "Donor lifetimes": {
      "attribute": "lifetime_spectrum",
      "accessor": "interleaved_to_two_columns",
      "accessor_kwargs": {
       "sort": true
      },
      "curve_options": {
       "stepMode": false,
       "connect": false,
       "bar_mode": "sticks",
       "symbol": "o"
      }
     }
    }
   }
  },
  {
   "key": "residual",
   "options": {}
  }
 ]
}
