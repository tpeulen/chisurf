{
  "_comment": "Editor layout for the anisotropy PDA model (PdaAnisotropyModel). PRD-38 model/view-spec split: compute stays in anisotropy.py; this JSON is user-editable.",
  "sections": [
    {
      "type": "panel",
      "title": "Calibration / background",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "nuisance",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Anisotropy species",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "dynamic_group",
          "target": "species",
          "rows_source": "_species_parameter_rows",
          "row_width": 2,
          "append_method": "append",
          "remove_method": "pop",
          "min_rows": 1,
          "collapsible": false,
          "style": "table"
        }
      ]
    },
    {
      "type": "panel",
      "title": "Fit histogram / statistic",
      "collapsible": true,
      "collapsed": true,
      "description": "Which 1D projection of the S1S2 count matrix the fit runs on, how it is binned, and how bins are weighted. Changing the axis resets the range to that axis' defaults.",
      "sections": [
        {
          "type": "choice",
          "target": "fit_settings",
          "attr": "axis",
          "label": "Axis",
          "options": [
            "S1/(S0+S1)",
            "S0/S1"
          ],
          "labels": [
            "Channel fraction S1/(S0+S1)",
            "Channel ratio S0/S1 (log)"
          ],
          "rebuild_on_change": true,
          "description": "Corrected axes (E, R) bin through the model's γ and R0, so they move with the correction factors; the raw ratios do not."
        },
        {
          "type": "choice",
          "target": "fit_settings",
          "attr": "statistic",
          "label": "Statistic",
          "options": [
            "poisson",
            "neyman",
            "pearson"
          ],
          "labels": [
            "Poisson deviance (MLE)",
            "Neyman χ² (data-weighted)",
            "Pearson χ² (model-weighted)"
          ],
          "description": "PDA histograms are sparse, where the χ² approximations are biased: Neyman pulls amplitudes low, Pearson high. The Poisson deviance is the likelihood-ratio statistic and is unbiased there — leave it selected unless reproducing a χ²-based analysis."
        },
        {
          "type": "custom",
          "key": "scalar_table",
          "target": "fit_settings",
          "options": {
            "title": "Binning",
            "rows": [
              {
                "attr": "n_bins",
                "label": "Bins",
                "kind": "int"
              },
              {
                "attr": "x_min",
                "label": "x<sub>min</sub>"
              },
              {
                "attr": "x_max",
                "label": "x<sub>max</sub>"
              },
              {
                "attr": "log_x",
                "label": "log x",
                "kind": "bool"
              },
              {
                "attr": "n_min",
                "label": "N<sub>min</sub> photons",
                "kind": "int"
              }
            ]
          }
        }
      ]
    }
  ],
  "plots": [
    {
      "key": "distribution",
      "options": {
        "with_residual_panel": true,
        "distribution_options": {
          "S_par/(S_par+S_perp)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 1.0,
                "x_min": 0.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "S1/(S0+S1)"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          }
        }
      }
    },
    {
      "key": "residual",
      "options": {}
    },
    {
      "key": "residual2d",
      "options": {
        "accessor": "chisurf.core.models.pda.common:get_pda_residual_image",
        "accessor_kwargs": {
          "weighted": true
        }
      }
    },
    {
      "key": "fit_info",
      "options": {}
    },
    {
      "key": "parameter_scan",
      "options": {}
    }
  ]
}
