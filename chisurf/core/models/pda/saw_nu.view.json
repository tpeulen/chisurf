{
  "_comment": "Editor layout for the SAW-nu polymer-distance PDA model (PdaSawNuModel). Compute stays in saw_nu.py; this JSON is user-editable.",
  "sections": [
    {
      "type": "panel",
      "title": "FRET parameters",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "fret_parameters",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Distance distribution",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "distances",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Corrections / nuisance",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "nuisance",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Diagnostics",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {
          "type": "button_row",
          "buttons": [
            {
              "label": "\ud83d\udd17 Apply light path",
              "action": "apply_light_path",
              "description": "Fill leakage, direct excitation and gamma from a simulated optical setup instead of leaving them as guesses. Uses the light-path graph below, or the light-path simulator's last session when that is empty."
            },
            {
              "label": "\ud83c\udfb2 Consistency check",
              "action": "run_consistency_check",
              "description": "Resample synthetic datasets from the fitted scheme and report where the measurement falls among them. A good chi2 says the model can be made to fit; this says whether the data could plausibly have come from it. Run it on a converged fit."
            }
          ]
        },
        {
          "type": "value",
          "attr": "lightpath_graph",
          "label": "Light path",
          "kind": "str",
          "description": "Path to a light-path graph or easy-mode config JSON. Empty uses the light-path simulator's last session."
        },
        {
          "type": "value",
          "attr": "consistency_resamples",
          "label": "Resamples",
          "kind": "int",
          "minimum": 20,
          "maximum": 100000,
          "description": "Bootstrap size. The p-value cannot resolve anything finer than 1/(n+1), so 200 is the practical floor for a 0.05 verdict."
        },
        {
          "type": "info",
          "source": "lightpath_html",
          "max_height": 90
        },
        {
          "type": "info",
          "source": "consistency_html",
          "max_height": 90
        }
      ]
    },
    {
      "type": "panel",
      "title": "Fit histogram / statistic",
      "collapsible": true,
      "collapsed": true,
      "description": "Which 1D projection of the S1S2 count matrix the fit runs on, how it is binned, and how bins are weighted. Changing the axis resets the range to that axis' defaults.",
      "sections": [
        {
          "type": "choice",
          "target": "fit_settings",
          "attr": "axis",
          "label": "Axis",
          "options": [
            "S1/(S0+S1)",
            "E",
            "S0/S1",
            "R"
          ],
          "labels": [
            "Proximity ratio S1/(S0+S1)",
            "FRET efficiency E (\u03b3-corrected)",
            "Intensity ratio S0/S1 (log)",
            "Distance R [\u00c5]"
          ],
          "rebuild_on_change": true,
          "description": "Corrected axes (E, R) bin through the model's \u03b3 and R0, so they move with the correction factors; the raw ratios do not."
        },
        {
          "type": "choice",
          "target": "fit_settings",
          "attr": "statistic",
          "label": "Statistic",
          "options": [
            "poisson",
            "neyman",
            "pearson"
          ],
          "labels": [
            "Poisson deviance (MLE)",
            "Neyman \u03c7\u00b2 (data-weighted)",
            "Pearson \u03c7\u00b2 (model-weighted)"
          ],
          "description": "PDA histograms are sparse, where the \u03c7\u00b2 approximations are biased: Neyman pulls amplitudes low, Pearson high. The Poisson deviance is the likelihood-ratio statistic and is unbiased there \u2014 leave it selected unless reproducing a \u03c7\u00b2-based analysis."
        },
        {
          "type": "custom",
          "key": "scalar_table",
          "target": "fit_settings",
          "options": {
            "title": "Binning",
            "rows": [
              {
                "attr": "n_bins",
                "label": "Bins",
                "kind": "int"
              },
              {
                "attr": "x_min",
                "label": "x<sub>min</sub>"
              },
              {
                "attr": "x_max",
                "label": "x<sub>max</sub>"
              },
              {
                "attr": "log_x",
                "label": "log x",
                "kind": "bool"
              },
              {
                "attr": "n_min",
                "label": "N<sub>min</sub> photons",
                "kind": "int"
              }
            ]
          }
        }
      ]
    }
  ],
  "plots": [
    {
      "key": "distribution",
      "options": {
        "with_residual_panel": true,
        "distribution_options": {
          "S1/(S0+S1)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 1.0,
                "x_min": 0.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "S1/(S0+S1)"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          },
          "S0/S1": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 500.0,
                "x_min": 0.01,
                "log_x": true,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "S0/S1"
              }
            },
            "scale_x": "log",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          },
          "Distance P(R)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distance_distribution",
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true
            },
            "accessor_kwargs": {}
          },
          "E (FRET efficiency)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 1.0,
                "x_min": 0.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "E"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          },
          "R [\u00c5]": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 100.0,
                "x_min": 20.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "R"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          }
        }
      }
    },
    {
      "key": "residual",
      "options": {}
    },
    {
      "key": "residual2d",
      "options": {
        "accessor": "chisurf.core.models.pda.common:get_pda_residual_image",
        "accessor_kwargs": {
          "weighted": true
        }
      }
    },
    {
      "key": "fit_info",
      "options": {}
    },
    {
      "key": "parameter_scan",
      "options": {}
    }
  ]
}
