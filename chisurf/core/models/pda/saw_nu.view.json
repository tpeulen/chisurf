{
  "_comment": "Editor layout for the SAW-nu polymer-distance PDA model (PdaSawNuModel). Compute stays in saw_nu.py; this JSON is user-editable.",
  "sections": [
    {
      "type": "panel",
      "title": "FRET parameters",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "fret_parameters",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Distance distribution",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "distances",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Corrections / nuisance",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "nuisance",
          "collapsible": false
        }
      ]
    }
  ],
  "plots": [
    {
      "key": "distribution",
      "options": {
        "with_residual_panel": true,
        "distribution_options": {
          "S1/(S0+S1)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 1.0,
                "x_min": 0.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "S1/(S0+S1)"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          },
          "S0/S1": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 500.0,
                "x_min": 0.01,
                "log_x": true,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "S0/S1"
              }
            },
            "scale_x": "log",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          },
          "Distance P(R)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distance_distribution",
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true
            },
            "accessor_kwargs": {}
          },
          "E (FRET efficiency)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 1.0,
                "x_min": 0.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "E"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          },
          "R [Å]": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 100.0,
                "x_min": 20.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "R"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          }
        }
      }
    },
    {
      "key": "residual",
      "options": {}
    },
    {
      "key": "residual2d",
      "options": {
        "accessor": "chisurf.core.models.pda.common:get_pda_residual_image",
