{
  "_comment": "Editor layout for the discrete PDA model (PdaSimpleModel). PRD-38 model/view-spec split: compute stays in simple.py; this JSON is user-editable (reorder sections, retitle, add plots).",
  "sections": [
    {
      "type": "panel",
      "title": "Photon-number range",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "nuisance",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Background",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {
          "type": "parameter_group_table",
          "target": "background",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Species (discrete)",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "toggle_row",
          "items": [
            {
              "target": "pch0",
              "attr": "absolute_amplitudes",
              "label": "Abs."
            },
            {
              "target": "pch0",
              "attr": "normalize_amplitudes",
              "label": "Norm."
            }
          ]
        },
        {
          "type": "dynamic_group",
          "target": "pch0",
          "rows_source": "_pch0_parameter_rows",
          "row_width": 2,
          "append_method": "append",
          "remove_method": "pop",
          "min_rows": 1,
          "collapsible": false,
          "style": "table"
        }
      ]
    },
    {
      "type": "panel",
      "title": "Fit histogram / statistic",
      "collapsible": true,
      "collapsed": true,
      "description": "Which 1D projection of the S1S2 count matrix the fit runs on, how it is binned, and how bins are weighted. Changing the axis resets the range to that axis' defaults.",
      "sections": [
        {
          "type": "choice",
          "target": "fit_settings",
          "attr": "axis",
          "label": "Axis",
          "options": [
            "S1/(S0+S1)",
            "E",
            "S0/S1",
            "R"
          ],
          "labels": [
            "Proximity ratio S1/(S0+S1)",
            "FRET efficiency E (γ-corrected)",
            "Intensity ratio S0/S1 (log)",
            "Distance R [Å]"
          ],
          "rebuild_on_change": true,
          "description": "Corrected axes (E, R) bin through the model's γ and R0, so they move with the correction factors; the raw ratios do not."
        },
        {
          "type": "choice",
          "target": "fit_settings",
          "attr": "statistic",
          "label": "Statistic",
          "options": [
            "poisson",
            "neyman",
            "pearson"
          ],
          "labels": [
            "Poisson deviance (MLE)",
            "Neyman χ² (data-weighted)",
            "Pearson χ² (model-weighted)"
          ],
          "description": "PDA histograms are sparse, where the χ² approximations are biased: Neyman pulls amplitudes low, Pearson high. The Poisson deviance is the likelihood-ratio statistic and is unbiased there — leave it selected unless reproducing a χ²-based analysis."
        },
        {
          "type": "custom",
          "key": "scalar_table",
          "target": "fit_settings",
          "options": {
            "title": "Binning",
            "rows": [
              {
                "attr": "n_bins",
                "label": "Bins",
                "kind": "int"
              },
              {
                "attr": "x_min",
                "label": "x<sub>min</sub>"
              },
              {
                "attr": "x_max",
                "label": "x<sub>max</sub>"
              },
              {
                "attr": "log_x",
                "label": "log x",
                "kind": "bool"
              },
              {
                "attr": "n_min",
                "label": "N<sub>min</sub> photons",
                "kind": "int"
              }
            ]
          }
        }
      ]
    }
  ],
  "plots": [
    {
      "key": "distribution",
      "options": {
        "with_residual_panel": true,
        "distribution_options": {
          "S1/(S0+S1)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 1.0,
                "x_min": 0.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "S1/(S0+S1)"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          },
          "S0/S1": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 500.0,
                "x_min": 0.01,
                "log_x": true,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "S0/S1"
              }
            },
            "scale_x": "log",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          }
        }
      }
    },
    {
      "key": "residual",
      "options": {}
    },
    {
      "key": "residual2d",
      "options": {
        "accessor": "chisurf.core.models.pda.common:get_pda_residual_image",
        "accessor_kwargs": {
          "weighted": true
        }
      }
    },
    {
      "key": "fit_info",
      "options": {}
    },
    {
      "key": "parameter_scan",
      "options": {}
    }
  ]
}
