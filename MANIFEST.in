include chisurf/structure/potential/database/*.csv
include chisurf/structure/potential/database/*.npy
include chisurf/models/fcs/*.yaml
include chisurf/models/parse/*.yaml
include chisurf/settings/*.yaml
include chisurf/settings/constants/*.json
include chisurf/gui/styles/*.css
include chisurf/gui/i18n/*.ts chisurf/gui/i18n/*.qm
include chisurf/plugins/spectra_viewer/*.db
# The curated sample_management.db seed is MMFDB package data, not ChiSurf's.
global-exclude *.db-wal *.db-shm
include notebooks/*.ipynb
recursive-include modules/chinet/chinet *.py
# The documentation an sdist carries is the documentation the *build* installs
# into the package (see _shipped_docs.py) -- the browser reads these at runtime.
recursive-include docs *.md *.rst *.png *.svg *.jpg *.jpeg *.gif *.json *.yaml *.bib
# Sphinx output, the retired Word original and its 103 MB of EMF figures: none
# of it is read by the application, and it dwarfs everything else in the tree.
prune docs/_build
prune docs/_old_manual
prune docs/_ext
recursive-include chisurf *.pyx *.pxd *.c *.cpp *.so
# Burbulator C++ sources (compiled at build time into the acq simulation lib)
recursive-include chisurf/plugins/core/acq/tcspc_devices/simulation/csrc *.cpp *.h *.def CMakeLists.txt
include _build_backend.py
include _shipped_docs.py
include README.md
include LICENSE

# Exclude entry point text files (now defined in pyproject.toml)
exclude chisurf/entry_points/*.txt

# Exclude build and development files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
exclude .gitignore
exclude .gitmodules

# Exclude development and playground directories
prune playground
